    private void ToggleAutoRefresh()
    {
        autoRefresh = !autoRefresh;
        if (autoRefresh)
        {
            StartAutoRefresh();
        }
        else
        {
            refreshCts?.Cancel();
            refreshCts?.Dispose();
            refreshCts = null;
        }
    }

    private void StartAutoRefresh()
    {
        refreshCts?.Cancel();
        refreshCts?.Dispose();
        refreshCts = new CancellationTokenSource();
        var token = refreshCts.Token;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            try
            {
                while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token))
                {
                    await InvokeAsync(async () =>
                    {
                        await RefreshStatus();
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
            }
        }, token);
    }

    private static bool HasCapability(IReadOnlyList<string> capabilities, string target)
    {
        for (var i = 0; i < capabilities.Count; i++)
        {
            if (string.Equals(capabilities[i], target, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static bool IsVolumeOffsiteVault(IReadOnlyList<string> capabilities) =>
        HasCapability(capabilities, VesselVolumeCapabilities.ReadOnly)
        && HasCapability(capabilities, VesselVolumeCapabilities.Mirrored);

    private static bool IsVolumeActiveHa(IReadOnlyList<string> capabilities) =>
        HasCapability(capabilities, VesselVolumeCapabilities.Ingest)
        && HasCapability(capabilities, VesselVolumeCapabilities.Mirrored)
        && !HasCapability(capabilities, VesselVolumeCapabilities.ReadOnly);

    private static bool IsPeerOffsiteVault(ClusterPeerDto peer) =>
        peer.Volumes.Count > 0 && peer.Volumes.All(static v => IsVolumeOffsiteVault(v.Capabilities));

    private static bool IsPeerActiveHa(ClusterPeerDto peer) =>
        peer.Volumes.Any(static v => IsVolumeActiveHa(v.Capabilities));

    private static string GetPeerRoleLabel(ClusterPeerDto peer, bool clusterEnabled)
    {
        if (!clusterEnabled && peer.Volumes.Count <= 1 && !IsPeerActiveHa(peer) && !IsPeerOffsiteVault(peer))
        {
            return "standalone";
        }

        if (IsPeerOffsiteVault(peer))
        {
            return "offsite vault";
        }

        if (IsPeerActiveHa(peer))
        {
            return "active-active ha";
        }

        return "ingest node";
    }

    private static string GetPeerRoleBadgeClass(ClusterPeerDto peer)
    {
        if (IsPeerOffsiteVault(peer))
        {
            return BadgeWarning;
        }

        if (IsPeerActiveHa(peer))
        {
            return BadgeMint;
        }

        return BadgeNeutral;
    }

    private static string GetVolumeRoleLabel(VolumeDto vol)
    {
        if (IsVolumeOffsiteVault(vol.Capabilities))
        {
            return HasCapability(vol.Capabilities, VesselVolumeCapabilities.OnDemand)
                ? "offsite vault · tier 2"
                : "mirror vault · ro";
        }

        if (IsVolumeActiveHa(vol.Capabilities))
        {
            return vol.IsRemote ? "ha peer · tier 1" : "ha primary · tier 0";
        }

        if (HasCapability(vol.Capabilities, VesselVolumeCapabilities.Mirrored))
        {
            return "mirror replica";
        }

        if (HasCapability(vol.Capabilities, VesselVolumeCapabilities.Ingest))
        {
            return vol.IsRemote ? "remote ingest · tier 1" : "local ingest · tier 0";
        }

        return "read-only";
    }

    private static string GetVolumeRoleBadgeClass(VolumeDto vol)
    {
        if (IsVolumeOffsiteVault(vol.Capabilities))
        {
            return BadgeWarning;
        }

        if (IsVolumeActiveHa(vol.Capabilities))
        {
            return vol.IsRemote ? BadgeAccent : BadgeMint;
        }

        if (HasCapability(vol.Capabilities, VesselVolumeCapabilities.Ingest))
        {
            return BadgeMint;
        }

        return BadgeNeutral;
    }

    private static string GetVolumeStatusBadgeClass(string status) =>
        VolumeStatusBadges.GetValueOrDefault(status, BadgeNeutral);

    private static string GetPeerStatusBadgeClass(string status) =>
        PeerStatusBadges.GetValueOrDefault(status, BadgeNeutral);

    private static string GetCapabilityBadgeClass(string capability) =>
        CapabilityBadges.GetValueOrDefault(capability, BadgeNeutral);

    private static string FormatAge(DateTimeOffset timestamp)
    {
        var elapsed = DateTimeOffset.UtcNow - timestamp;
        if (elapsed.TotalSeconds < 1)
        {
            return "just now";
        }
        if (elapsed.TotalSeconds < 60)
        {
            return $"{(int)elapsed.TotalSeconds}s ago";
        }
        if (elapsed.TotalMinutes < 60)
        {
            return $"{(int)elapsed.TotalMinutes}m ago";
        }
        return timestamp.ToString("HH:mm:ss 'UTC'", CultureInfo.InvariantCulture);
    }

    public ValueTask DisposeAsync()
    {
        refreshCts?.Cancel();
        refreshCts?.Dispose();
        return ValueTask.CompletedTask;
    }
