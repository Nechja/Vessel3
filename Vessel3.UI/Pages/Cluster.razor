@page "/cluster"
@using System.Collections.Frozen
@using System.Globalization
@implements IAsyncDisposable
@inject IVesselClient Client
@inject UiNotifications Toast
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="stack" style="gap: var(--space-4);">
    <div class="toolbar">
        <div class="toolbar-left">
            <span class="toolbar-title">Cluster &amp; Volumes</span>
            @if (status is { } s)
            {
                <span class="counter">@(s.Peers.Count + 1) nodes · @s.Volumes.Count volumes</span>
            }
        </div>
        <div class="toolbar-actions">
            <button type="button" class="btn @(autoRefresh ? "btn-primary" : "btn-ghost") btn-sm" @onclick="ToggleAutoRefresh">
                <Icon Name="refresh" /> @(autoRefresh ? "auto-refresh: on" : "auto-refresh: off")
            </button>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="RefreshStatus" disabled="@loading">
                <Icon Name="refresh" /> refresh
            </button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="OpenJoinModal">
                <Icon Name="server" /> join peer / offsite nas
            </button>
        </div>
    </div>

    @if (status is { } st)
    {
        <div class="grid grid-4">
            <div class="stat-card">
                <div class="row justify-between align-center" style="margin-bottom: var(--space-1);">
                    <div class="stat-kicker" style="margin-bottom: 0;">Local Node</div>
                    <span class="badge @GetPeerRoleBadgeClass(st.LocalNode) mono" style="font-size: 10px;">
                        @GetPeerRoleLabel(st.LocalNode, st.ClusterEnabled)
                    </span>
                </div>
                <div class="stat-value">@st.NodeId</div>
                <div class="stat-sub mono">
                    @if (!string.IsNullOrEmpty(st.LocalNode.Endpoint))
                    {
                        @st.LocalNode.Endpoint
                    }
                    else
                    {
                        <span>standalone (@st.Region)</span>
                    }
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-kicker">Cluster Membership</div>
                <div class="stat-value">@AlivePeerCount / @(st.Peers.Count + 1)</div>
                <div class="stat-sub">
                    @if (st.Peers.Count == 0)
                    {
                        <span>@(st.ClusterEnabled ? "awaiting gossip peers" : "single-node topology")</span>
                    }
                    else
                    {
                        <span>@ActiveHaNodeCount active-active · @OffsiteVaultNodeCount offsite · @DeadPeerCount dead</span>
                    }
                </div>
            </div>

            <div class="stat-card">
                <div class="row justify-between align-center" style="margin-bottom: var(--space-1);">
                    <div class="stat-kicker" style="margin-bottom: 0;">Replication &amp; Self-Heal</div>
                    <span class="badge @(st.PendingMirrorBlobs == 0 ? "badge-mint" : "badge-warning") mono" style="font-size: 10px;">
                        @(st.PendingMirrorBlobs == 0 ? "watermarks synced" : "pulling blobs")
                    </span>
                </div>
                <div class="stat-value">@(st.PendingMirrorBlobs == 0 ? "in sync" : $"{st.PendingMirrorBlobs} queued")</div>
                <div class="stat-sub mono">
                    iam gen #@st.IamGeneration · @BucketWatermarks.Count buckets · @MirroredVolumeCount mirrored
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-kicker">Local Disk Capacity</div>
                @if (TotalLocalCapacityBytes > 0)
                {
                    <div class="stat-value">@Fmt.Bytes(TotalLocalAvailableBytes) free</div>
                    <div style="margin-top: var(--space-2);">
                        <div class="progress-track">
                            <div class="progress-fill" style="width: @(LocalUsedPercent.ToString("F1", CultureInfo.InvariantCulture))%;"></div>
                        </div>
                    </div>
                    <div class="stat-sub mono">
                        @Fmt.Bytes(TotalLocalUsedBytes) used of @Fmt.Bytes(TotalLocalCapacityBytes)
                    </div>
                }
                else
                {
                    <div class="stat-value">—</div>
                    <div class="stat-sub">capacity metrics unavailable</div>
                }
            </div>
        </div>

        <div class="stack" style="gap: var(--space-3);">
            <div class="toolbar">
                <div class="toolbar-left">
                    <h2 style="margin: 0;">Storage Volumes</h2>
                    <span class="counter">@FilteredVolumes.Count</span>
                </div>
                <div class="toolbar-actions">
                    <div class="row align-center" style="gap: var(--space-2);">
                        <span class="muted" style="font-size: var(--text-xs);">Role:</span>
                        <select class="input mono" @bind="roleFilter" style="font-size: var(--text-xs); width: 150px;">
                            <option value="">All Roles</option>
                            <option value="@RoleActiveHa">Active-Active HA</option>
                            <option value="@RoleOffsiteVault">Offsite Vault</option>
                        </select>
                    </div>
                    <div class="row align-center" style="gap: var(--space-2);">
                        <span class="muted" style="font-size: var(--text-xs);">Scope:</span>
                        <select class="input mono" @bind="scopeFilter" style="font-size: var(--text-xs); width: 120px;">
                            <option value="">All Scopes</option>
                            <option value="@ScopeLocal">Local Only</option>
                            <option value="@ScopeRemote">Remote Only</option>
                        </select>
                    </div>
                    <div class="row align-center" style="gap: var(--space-2);">
                        <span class="muted" style="font-size: var(--text-xs);">Pool:</span>
                        <select class="input mono" @bind="poolFilter" style="font-size: var(--text-xs); width: 140px;">
                            <option value="">All Pools</option>
                            @foreach (var pool in PoolNames)
                            {
                                <option value="@pool">@pool</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="table-card">
                <table>
                    <thead>
                        <tr>
                            <th>volume id</th>
                            <th style="width: 150px;">node / scope</th>
                            <th style="width: 170px;">role / read tier</th>
                            <th style="width: 100px;">pool</th>
                            <th>capabilities</th>
                            <th>location / endpoint</th>
                            <th style="width: 200px;">capacity</th>
                            <th style="width: 100px;">status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (FilteredVolumes.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="empty-state">no storage volumes matching filter criteria.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var vol in FilteredVolumes)
                            {
                                <tr>
                                    <td>
                                        <div class="row align-center" style="gap: var(--space-2);">
                                            <span class="mono" style="font-weight: var(--weight-semibold);">@vol.Id</span>
                                            @if (vol.IsDefaultIngest)
                                            {
                                                <span class="badge badge-accent mono" style="font-size: 10px;">default ingest</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="row align-center" style="gap: var(--space-1);">
                                            <span class="badge @(vol.IsRemote ? "badge-accent" : "badge-mint") mono" style="font-size: 10px;">
                                                @(vol.IsRemote ? "remote" : "local")
                                            </span>
                                            @if (!string.IsNullOrEmpty(vol.NodeId))
                                            {
                                                <span class="mono muted" style="font-size: 11px;">@vol.NodeId</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @GetVolumeRoleBadgeClass(vol) mono" style="font-size: 10px;">
                                            @GetVolumeRoleLabel(vol)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge badge-neutral mono">@vol.Pool</span>
                                    </td>
                                    <td>
                                        <div class="row" style="gap: 4px;">
                                            @foreach (var cap in vol.Capabilities)
                                            {
                                                <span class="badge @GetCapabilityBadgeClass(cap) mono" style="font-size: 10px;">@cap</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="mono muted" style="font-size: 11px; word-break: break-all;">@vol.Path</span>
                                    </td>
                                    <td>
                                        @if (vol.CapacityBytes is > 0 and var capBytes && vol.AvailableBytes is { } availBytes)
                                        {
                                            var usedBytes = Math.Max(0L, capBytes - availBytes);
                                            var pct = Math.Clamp(usedBytes * 100.0 / capBytes, 0.0, 100.0);
                                            <div class="stack" style="gap: 4px;">
                                                <div class="progress-track">
                                                    <div class="progress-fill" style="width: @(pct.ToString("F1", CultureInfo.InvariantCulture))%;"></div>
                                                </div>
                                                <span class="mono muted" style="font-size: 10px;">
                                                    @Fmt.Bytes(availBytes) free / @Fmt.Bytes(capBytes)
                                                </span>
                                            </div>
                                        }
                                        else if (vol.AvailableBytes is { } availOnly)
                                        {
                                            <span class="mono muted" style="font-size: 11px;">@Fmt.Bytes(availOnly) free</span>
                                        }
                                        else
                                        {
                                            <span class="mono muted" style="font-size: 11px;">—</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @GetVolumeStatusBadgeClass(vol.Status) mono">@vol.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="stack" style="gap: var(--space-3);">
            <div class="toolbar">
                <div class="toolbar-left">
                    <h2 style="margin: 0;">Cluster Membership (SWIM Gossip)</h2>
                    <span class="counter">@(st.Peers.Count + 1)</span>
                </div>
            </div>

            <div class="table-card">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 190px;">node id</th>
                            <th style="width: 165px;">topology role</th>
                            <th style="width: 220px;">gossip endpoint</th>
                            <th style="width: 100px;">status</th>
                            <th style="width: 100px;">incarnation</th>
                            <th style="width: 140px;">last seen</th>
                            <th>advertised volumes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (peer, isSelf) in AllNodes)
                        {
                            <tr>
                                <td>
                                    <div class="row align-center" style="gap: var(--space-2);">
                                        <span class="mono" style="font-weight: var(--weight-semibold);">@peer.NodeId</span>
                                        @if (isSelf)
                                        {
                                            <span class="badge badge-accent mono" style="font-size: 10px;">self</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @GetPeerRoleBadgeClass(peer) mono" style="font-size: 10px;">
                                        @GetPeerRoleLabel(peer, st.ClusterEnabled)
                                    </span>
                                </td>
                                <td>
                                    <span class="mono muted" style="font-size: 11px;">
                                        @(string.IsNullOrEmpty(peer.Endpoint) ? "local-only" : peer.Endpoint)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @GetPeerStatusBadgeClass(peer.Status) mono">@peer.Status</span>
                                </td>
                                <td class="mono muted">@peer.Incarnation</td>
                                <td class="mono muted" style="font-size: 11px;" title="@peer.LastSeenUtc.ToString("u")">
                                    @(isSelf ? "now" : FormatAge(peer.LastSeenUtc))
                                </td>
                                <td>
                                    @if (peer.Volumes.Count == 0)
                                    {
                                        <span class="mono muted" style="font-size: 11px;">none</span>
                                    }
                                    else
                                    {
                                        <div class="row" style="gap: 6px;">
                                            @foreach (var adv in peer.Volumes)
                                            {
                                                <span class="badge @GetVolumeStatusBadgeClass(adv.Status) mono" style="font-size: 10px;">
                                                    @adv.VolumeId (@adv.Pool)
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="stack" style="gap: var(--space-3);">
            <div class="toolbar">
                <div class="toolbar-left">
                    <h2 style="margin: 0;">Bucket Replication Watermarks</h2>
                    <span class="counter">@BucketWatermarks.Count</span>
                </div>
            </div>

            <div class="table-card">
                <table>
                    <thead>
                        <tr>
                            <th>bucket</th>
                            <th style="width: 150px;">applied seq</th>
                            <th style="width: 150px;">compaction floor</th>
                            <th style="width: 130px;">versioning</th>
                            <th style="width: 150px;">access policy</th>
                            <th style="width: 210px;">replication state</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (BucketWatermarks.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="empty-state">no buckets provisioned yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var b in BucketWatermarks)
                            {
                                <tr>
                                    <td>
                                        <a href="buckets/@b.Name" class="row align-center" style="text-decoration: none; color: var(--color-text); font-weight: var(--weight-semibold); gap: var(--space-2);">
                                            <Icon Name="bucket" Class="faint" />
                                            <span class="mono">@b.Name</span>
                                        </a>
                                    </td>
                                    <td>
                                        <span class="mono" style="font-weight: var(--weight-semibold);">seq #@b.AppliedSeq</span>
                                    </td>
                                    <td>
                                        <span class="mono muted" style="font-size: 11px;">log #@b.FirstAvailableLogSeq</span>
                                    </td>
                                    <td>
                                        <span class="badge @(string.Equals(b.VersioningStatus, "Enabled", StringComparison.OrdinalIgnoreCase) ? "badge-mint" : "badge-neutral") mono" style="font-size: 10px;">
                                            @b.VersioningStatus.ToLowerInvariant()
                                        </span>
                                    </td>
                                    <td>
                                        <div class="row" style="gap: 4px;">
                                            @if (b.ReadOnly)
                                            {
                                                <span class="badge badge-warning mono" style="font-size: 10px;">read-only</span>
                                            }
                                            @if (b.PublicRead)
                                            {
                                                <span class="badge badge-accent mono" style="font-size: 10px;">public-read</span>
                                            }
                                            @if (!b.ReadOnly && !b.PublicRead)
                                            {
                                                <span class="badge badge-neutral mono" style="font-size: 10px;">private</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (MirroredVolumeCount > 1)
                                        {
                                            <span class="badge @(st.PendingMirrorBlobs == 0 ? "badge-mint" : "badge-warning") mono" style="font-size: 10px;">
                                                @(st.PendingMirrorBlobs == 0 ? $"mirrored ({MirroredVolumeCount} vols)" : $"syncing ({MirroredVolumeCount} vols)")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-neutral mono" style="font-size: 10px;">local volume only</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (loading)
    {
        <div class="panel empty-state">loading cluster and volume topology...</div>
    }
    else
    {
        <div class="panel empty-state">cluster status unavailable.</div>
    }
</div>

<Modal IsOpen="showJoinModal" Title="Join Cluster Peer or Offsite NAS" OnClose="@(() => showJoinModal = false)">
    <ChildContent>
        <div class="stack" style="gap: var(--space-4);">
            <div class="field" style="margin-bottom: 0;">
                <label>Node Topology Preset</label>
                <div class="grid grid-2" style="gap: var(--space-2);">
                    <button type="button"
                            class="btn @(joinPreset == PresetOffsite ? "btn-primary" : "btn-ghost")"
                            style="justify-content: flex-start; padding: var(--space-3);"
                            @onclick="@(() => SelectJoinPreset(PresetOffsite))">
                        <Icon Name="shield" /> offsite tailscale vault
                    </button>
                    <button type="button"
                            class="btn @(joinPreset == PresetActiveHa ? "btn-primary" : "btn-ghost")"
                            style="justify-content: flex-start; padding: var(--space-3);"
                            @onclick="@(() => SelectJoinPreset(PresetActiveHa))">
                        <Icon Name="server" /> active-active lan peer
                    </button>
                </div>
                <span class="muted" style="font-size: var(--text-xs);">
                    @if (joinPreset == PresetOffsite)
                    {
                        <span>Configures <code class="mono">ReadOnly+Mirrored+OnDemand</code> so the node rejects client writes, continuously mirrors metadata and blobs in the background, and serves fallback reads only when LAN copies are unreachable.</span>
                    }
                    else
                    {
                        <span>Configures <code class="mono">Ingest+Mirrored</code> so every node accepts S3/OCI/Azure writes and replicates deterministically across plain <code class="mono">ext4</code> or <code class="mono">local-path</code> drives.</span>
                    }
                </span>
            </div>

            <div class="grid grid-2" style="gap: var(--space-3);">
                <div class="field" style="margin-bottom: 0;">
                    <label>New Peer Node ID</label>
                    <input class="input mono" @bind="joinNodeId" @bind:event="oninput" placeholder="pi-offsite-vault" />
                </div>
                <div class="field" style="margin-bottom: 0;">
                    <label>New Peer Advertised Endpoint</label>
                    <input class="input mono" @bind="joinAdvertiseEndpoint" @bind:event="oninput" placeholder="http://100.94.18.42:9000" />
                </div>
            </div>

            <div class="field" style="margin-bottom: 0;">
                <div class="row justify-between align-center">
                    <label>Docker / Raspberry Pi Command</label>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => CopySnippet(DockerJoinSnippet, "Docker command"))">
                        <Icon Name="copy" /> copy docker
                    </button>
                </div>
                <pre class="mono" style="background: var(--color-surface-sunken); padding: var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--color-border); font-size: var(--text-xs); overflow-x: auto; margin: 0;">@DockerJoinSnippet</pre>
            </div>

            <div class="field" style="margin-bottom: 0;">
                <div class="row justify-between align-center">
                    <label>Kubernetes / Helm Values</label>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => CopySnippet(HelmJoinSnippet, "Helm values"))">
                        <Icon Name="copy" /> copy helm
                    </button>
                </div>
                <pre class="mono" style="background: var(--color-surface-sunken); padding: var(--space-3); border-radius: var(--radius-sm); border: 1px solid var(--color-border); font-size: var(--text-xs); overflow-x: auto; margin: 0;">@HelmJoinSnippet</pre>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-ghost" @onclick="@(() => showJoinModal = false)">close</button>
    </FooterContent>
</Modal>

@code {
    private const string ScopeLocal = "local";
    private const string ScopeRemote = "remote";
    private const string RoleActiveHa = "active-ha";
    private const string RoleOffsiteVault = "offsite-vault";
    private const string PresetOffsite = "offsite";
    private const string PresetActiveHa = "active-ha";
    private const string BadgeMint = "badge-mint";
    private const string BadgeNeutral = "badge-neutral";
    private const string BadgeWarning = "badge-warning";
    private const string BadgeDanger = "badge-danger";
    private const string BadgeAccent = "badge-accent";

    private static readonly FrozenDictionary<string, string> VolumeStatusBadges = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        [VesselVolumeStatuses.Online] = BadgeMint,
        [VesselVolumeStatuses.Standby] = BadgeNeutral,
        [VesselVolumeStatuses.Waking] = BadgeWarning,
        [VesselVolumeStatuses.Degraded] = BadgeWarning,
        [VesselVolumeStatuses.Faulted] = BadgeDanger,
    }.ToFrozenDictionary(StringComparer.OrdinalIgnoreCase);

    private static readonly FrozenDictionary<string, string> PeerStatusBadges = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        [VesselPeerStatuses.Alive] = BadgeMint,
        [VesselPeerStatuses.Suspect] = BadgeWarning,
        [VesselPeerStatuses.Dead] = BadgeDanger,
        [VesselPeerStatuses.Left] = BadgeNeutral,
    }.ToFrozenDictionary(StringComparer.OrdinalIgnoreCase);

    private static readonly FrozenDictionary<string, string> CapabilityBadges = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        [VesselVolumeCapabilities.Ingest] = BadgeMint,
        [VesselVolumeCapabilities.Remote] = BadgeAccent,
        [VesselVolumeCapabilities.ReadOnly] = BadgeNeutral,
        [VesselVolumeCapabilities.OnDemand] = BadgeWarning,
        [VesselVolumeCapabilities.Mirrored] = BadgeAccent,
    }.ToFrozenDictionary(StringComparer.OrdinalIgnoreCase);

    private ClusterStatusDto? status;
    private bool loading = true;
    private bool refreshing;
    private bool autoRefresh;
    private string scopeFilter = string.Empty;
    private string poolFilter = string.Empty;
    private string roleFilter = string.Empty;
    private bool showJoinModal;
    private string joinPreset = PresetOffsite;
    private string joinNodeId = "pi-offsite-vault";
    private string joinAdvertiseEndpoint = "http://100.94.18.42:9000";
    private CancellationTokenSource? refreshCts;

    private int AlivePeerCount =>
        status is null
            ? 0
            : (string.Equals(status.LocalNode.Status, VesselPeerStatuses.Alive, StringComparison.OrdinalIgnoreCase) ? 1 : 0)
              + status.Peers.Count(static p => string.Equals(p.Status, VesselPeerStatuses.Alive, StringComparison.OrdinalIgnoreCase));

    private int DeadPeerCount =>
        status?.Peers.Count(static p => string.Equals(p.Status, VesselPeerStatuses.Dead, StringComparison.OrdinalIgnoreCase)) ?? 0;

    private int ActiveHaNodeCount =>
        AllNodes.Count(static n => IsPeerActiveHa(n.Peer));

    private int OffsiteVaultNodeCount =>
        AllNodes.Count(static n => IsPeerOffsiteVault(n.Peer));

    private int MirroredVolumeCount =>
        status?.Volumes.Count(static v => HasCapability(v.Capabilities, VesselVolumeCapabilities.Mirrored)) ?? 0;

    private IReadOnlyList<BucketReplicationDto> BucketWatermarks =>
        status?.BucketWatermarks ?? [];

    private IReadOnlyList<string> PoolNames =>
        status is null
            ? []
            : [.. status.Volumes.Select(static v => v.Pool).Distinct(StringComparer.Ordinal).OrderBy(static p => p, StringComparer.Ordinal)];

    private long TotalLocalCapacityBytes =>
        status?.Volumes
            .Where(static v => !v.IsRemote && v.CapacityBytes is > 0)
            .Sum(static v => v.CapacityBytes ?? 0L) ?? 0L;

    private long TotalLocalAvailableBytes =>
        status?.Volumes
            .Where(static v => !v.IsRemote && v.CapacityBytes is > 0)
            .Sum(static v => v.AvailableBytes ?? 0L) ?? 0L;

    private long TotalLocalUsedBytes =>
        Math.Max(0L, TotalLocalCapacityBytes - TotalLocalAvailableBytes);

    private double LocalUsedPercent =>
        TotalLocalCapacityBytes > 0
            ? Math.Clamp(TotalLocalUsedBytes * 100.0 / TotalLocalCapacityBytes, 0.0, 100.0)
            : 0.0;

    private string SeedEndpoint
    {
        get
        {
            if (status is { } st && !string.IsNullOrEmpty(st.LocalNode.Endpoint))
            {
                return st.LocalNode.Endpoint;
            }

            return Nav.BaseUri.TrimEnd('/');
        }
    }

    private string DockerJoinSnippet
    {
        get
        {
            var nodeId = string.IsNullOrWhiteSpace(joinNodeId) ? "pi-node-02" : joinNodeId.Trim();
            var adv = string.IsNullOrWhiteSpace(joinAdvertiseEndpoint) ? "http://100.94.18.42:9000" : joinAdvertiseEndpoint.Trim();
            var volSpec = joinPreset == PresetOffsite
                ? "vault:/data:offsite-backup:ReadOnly+Mirrored+OnDemand"
                : "local:/data:default:Ingest+Mirrored";

            return $"""
                docker run -d --name vessel3-{nodeId} \
                  -p 9000:9000 \
                  -v /mnt/usb-nas:/data \
                  -e {VesselEnvVars.NodeId}={nodeId} \
                  -e {VesselEnvVars.AdvertiseUrl}={adv} \
                  -e {VesselEnvVars.Peers}={SeedEndpoint} \
                  -e {VesselEnvVars.ClusterSecret}=<your-cluster-secret> \
                  -e {VesselEnvVars.Volumes}="{volSpec}" \
                  ghcr.io/nechja/vessel3:latest
                """;
        }
    }

