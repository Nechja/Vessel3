@page "/uploads"
@inject IVesselClient Client
@inject UiNotifications Toast

<div class="stack" style="gap: var(--space-6);">
    <div>
        <div class="eyebrow">ingest</div>
        <h1>Uploads</h1>
        <p class="lead">Upload files directly into buckets via native high-throughput streaming.</p>
    </div>

    <div class="panel">
        <div class="grid grid-2" style="margin-bottom: var(--space-4);">
            <div class="field">
                <label>Destination Bucket</label>
                <select class="select" @bind="selectedBucket" disabled="@loadingBuckets">
                    @if (buckets.Count == 0)
                    {
                        <option value="">(no buckets available)</option>
                    }
                    else
                    {
                        @foreach (var b in buckets)
                        {
                            <option value="@b">@b</option>
                        }
                    }
                </select>
            </div>
            <div class="field">
                <label>Folder Prefix (Optional)</label>
                <input class="input mono" @bind="targetPrefix" placeholder="subfolder/ (optional)" />
            </div>
        </div>

        <InputFile id="fileUploadInput" OnChange="OnFilesSelected" multiple style="display:none;" />
        <label for="fileUploadInput" class="dropzone">
            <div class="stack align-center" style="gap: var(--space-2);">
                <Icon Name="upload" Class="icon-lg" />
                <div style="font-weight: var(--weight-semibold);">click to select files or drop them here</div>
                <div class="faint mono" style="font-size: var(--text-xs);">
                    @(string.IsNullOrEmpty(selectedBucket) ? "select a bucket first" : $"destination: {selectedBucket}/{targetPrefix}")
                </div>
            </div>
        </label>
    </div>

    @if (jobs.Count > 0)
    {
        <div>
            <h2>Upload Queue (@jobs.Count)</h2>
            <div class="table-card">
                <table>
                    <thead>
                        <tr>
                            <th>destination</th>
                            <th>size</th>
                            <th>status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in jobs)
                        {
                            <tr>
                                <td>
                                    <span class="mono" style="font-weight: var(--weight-semibold);">
                                        @job.Bucket / @job.Key
                                    </span>
                                </td>
                                <td>
                                    <span class="mono muted">@Fmt.Bytes(job.Size)</span>
                                </td>
                                <td>
                                    @if (job.State == UploadState.Done)
                                    {
                                        <span class="badge badge-mint">
                                            <Icon Name="check" /> done
                                        </span>
                                    }
                                    else if (job.State == UploadState.Uploading)
                                    {
                                        <span class="badge badge-accent">uploading...</span>
                                    }
                                    else if (job.State == UploadState.Failed)
                                    {
                                        <span class="badge badge-danger" title="@job.Error">
                                            failed: @job.Error
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-neutral">queued</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    const long MaxUploadBytes = 5L * 1024 * 1024 * 1024;

    [SupplyParameterFromQuery(Name = "bucket")] public string? QueryBucket { get; set; }
    [SupplyParameterFromQuery(Name = "prefix")] public string? QueryPrefix { get; set; }

    private string? selectedBucket;
    private string targetPrefix = "";
    private List<string> buckets = [];
    private bool loadingBuckets = true;
    private readonly List<UploadJob> jobs = [];
    private readonly SemaphoreSlim gate = new(4);

    private sealed class UploadJob
    {
        public string Bucket { get; init; } = "";
        public string Key { get; init; } = "";
        public long Size { get; init; }
        public UploadState State { get; set; } = UploadState.Queued;
        public string? Error { get; set; }
    }

    private enum UploadState { Queued, Uploading, Done, Failed }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var res = await Client.ListBucketsAsync();
            if (res.TryGetValue(out var list, out _))
            {
                buckets = list.Select(b => b.Name).OrderBy(n => n, StringComparer.Ordinal).ToList();
                if (!string.IsNullOrEmpty(QueryBucket) && buckets.Contains(QueryBucket))
                {
                    selectedBucket = QueryBucket;
                }
                else if (buckets.Count > 0)
                {
                    selectedBucket = buckets[0];
                }

                if (!string.IsNullOrEmpty(QueryPrefix))
                {
                    targetPrefix = QueryPrefix;
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to list buckets: {ex.Message}");
        }
        finally
        {
            loadingBuckets = false;
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(selectedBucket))
        {
            Toast.Error("Please select a target bucket");
            return;
        }

        var bucket = selectedBucket;
        var prefix = targetPrefix?.Trim() ?? "";
        if (!string.IsNullOrEmpty(prefix) && !prefix.EndsWith('/'))
        {
            prefix += "/";
        }

        foreach (var file in e.GetMultipleFiles(maximumFileCount: 50))
        {
            _ = StartUpload(bucket, prefix, file);
        }
    }

    private async Task StartUpload(string bucket, string prefix, IBrowserFile file)
    {
        var key = $"{prefix}{file.Name}";
        var job = new UploadJob { Bucket = bucket, Key = key, Size = file.Size };
        jobs.Insert(0, job);
        StateHasChanged();

        if (file.Size > MaxUploadBytes)
        {
            job.State = UploadState.Failed;
            job.Error = $"{Fmt.Bytes(file.Size)} exceeds maximum allowed size";
            StateHasChanged();
            return;
        }

        await gate.WaitAsync();
        job.State = UploadState.Uploading;
        StateHasChanged();

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: MaxUploadBytes);
            var res = await Client.PutObjectAsync(bucket, key, stream, string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType);
            if (!res.TryGetValue(out _, out var err))
            {
                job.State = UploadState.Failed;
                job.Error = err.Message;
                Toast.Error($"Upload failed for {file.Name}: {err.Message}");
            }
            else
            {
                job.State = UploadState.Done;
                Toast.Success($"Uploaded {file.Name}");
            }
        }
        catch (Exception ex)
        {
            job.State = UploadState.Failed;
            job.Error = ex.Message;
            Toast.Error($"Upload failed for {file.Name}: {ex.Message}");
        }
        finally
        {
            gate.Release();
            StateHasChanged();
        }
    }
}
