@page "/admin"
@inject IVesselClient Client
@inject UiNotifications Toast

<div class="stack" style="gap: var(--space-4);">
    <div class="toolbar">
        <div class="toolbar-left">
            <span class="toolbar-title">Maintenance & GC</span>
        </div>
    </div>

    <div class="grid grid-2">
        <div class="panel stack" style="gap: var(--space-4);">
            <div>
                <h3>Garbage Collector</h3>
                <p class="muted" style="font-size: var(--text-xs);">
                    Delete unreferenced blobs and reap abandoned multipart uploads from the storage pool.
                </p>
            </div>

            <div class="grid grid-2">
                <div class="field">
                    <label>Min Blob Age (Seconds)</label>
                    <input type="number" class="input mono" @bind="gcBlobAgeSec" />
                </div>
                <div class="field">
                    <label>Min Upload Age (Seconds)</label>
                    <input type="number" class="input mono" @bind="gcUploadAgeSec" />
                </div>
            </div>

            <button type="button" class="btn btn-primary" @onclick="RunGc" disabled="@gcBusy">
                <Icon Name="trash" /> @(gcBusy ? "running gc..." : "run garbage collector")
            </button>

            @if (gcReport is { } gc)
            {
                <hr />
                <div class="stack" style="gap: var(--space-2);">
                    <div class="row justify-between mono" style="font-size: var(--text-sm);">
                        <span class="muted">blobs deleted</span>
                        <span style="font-weight: var(--weight-bold); color: var(--color-mint);">@gc.BlobsDeleted</span>
                    </div>
                    <div class="row justify-between mono" style="font-size: var(--text-sm);">
                        <span class="muted">uploads reaped</span>
                        <span style="font-weight: var(--weight-bold); color: var(--color-mint);">@gc.UploadsReaped</span>
                    </div>
                </div>
            }
        </div>

        <div class="panel stack" style="gap: var(--space-4);">
            <div>
                <h3>Lifecycle Sweep</h3>
                <p class="muted" style="font-size: var(--text-xs);">
                    Expire object versions according to bucket lifecycle rules and clean up lone delete markers.
                </p>
            </div>

            <div class="field">
                <label>Now Override (ISO 8601, Optional)</label>
                <input class="input mono" @bind="sweepNow" placeholder="@DateTimeOffset.UtcNow.ToString("u")" />
            </div>

            <button type="button" class="btn btn-primary" @onclick="RunSweep" disabled="@sweepBusy">
                <Icon Name="refresh" /> @(sweepBusy ? "running sweep..." : "run lifecycle sweep")
            </button>

            @if (sweepReport is { } sweep)
            {
                <hr />
                <div class="stack" style="gap: var(--space-2);">
                    <div class="row justify-between mono" style="font-size: var(--text-sm);">
                        <span class="muted">versions expired</span>
                        <span style="font-weight: var(--weight-bold); color: var(--color-mint);">@sweep.Expired</span>
                    </div>
                    <div class="row justify-between mono" style="font-size: var(--text-sm);">
                        <span class="muted">markers reaped</span>
                        <span style="font-weight: var(--weight-bold); color: var(--color-mint);">@sweep.MarkersReaped</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private long gcBlobAgeSec = 3600;
    private long gcUploadAgeSec = 604800;
    private string sweepNow = "";
    private bool gcBusy;
    private bool sweepBusy;
    private GcReportDto? gcReport;
    private SweepReportDto? sweepReport;

    private async Task RunGc()
    {
        gcBusy = true;
        try
        {
            var res = await Client.RunGcAsync(gcBlobAgeSec, gcUploadAgeSec);
            if (!res.TryGetValue(out var report, out var err))
            {
                Toast.Error($"GC failed: {err.Message}");
                return;
            }

            gcReport = report;
            Toast.Success($"GC complete: {report.BlobsDeleted} blobs deleted, {report.UploadsReaped} uploads reaped");
        }
        catch (Exception ex)
        {
            Toast.Error($"GC error: {ex.Message}");
        }
        finally
        {
            gcBusy = false;
        }
    }

    private async Task RunSweep()
    {
        sweepBusy = true;
        try
        {
            var res = await Client.RunSweepAsync(string.IsNullOrWhiteSpace(sweepNow) ? null : sweepNow);
            if (!res.TryGetValue(out var report, out var err))
            {
                Toast.Error($"Sweep failed: {err.Message}");
                return;
            }

            sweepReport = report;
            Toast.Success($"Sweep complete: {report.Expired} expired, {report.MarkersReaped} markers reaped");
        }
        catch (Exception ex)
        {
            Toast.Error($"Sweep error: {ex.Message}");
        }
        finally
        {
            sweepBusy = false;
        }
    }
}
