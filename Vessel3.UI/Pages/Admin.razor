@page "/admin"
@inject IVesselClient Client
@inject UiNotifications Toast

<div class="stack">
    <div class="toolbar">
        <div class="toolbar-left">
            <span class="toolbar-title">Maintenance</span>
        </div>
    </div>

    <div class="grid grid-3">
        <div class="panel stack">
            <h3>Garbage Collector</h3>

            <div class="field">
                <label>Min Blob Age (Seconds)</label>
                <input type="number" class="input mono" @bind="gcBlobAgeSec" />
            </div>
            <div class="field">
                <label>Min Upload Age (Seconds)</label>
                <input type="number" class="input mono" @bind="gcUploadAgeSec" />
            </div>

            <button type="button" class="btn btn-primary" @onclick="RunGc" disabled="@gcBusy">
                <Icon Name="trash" /> @(gcBusy ? "running..." : "run")
            </button>

            @if (gcReport is { } gc)
            {
                <hr />
                <div class="stack gap-2">
                    <div class="kv"><span>blobs deleted</span><strong>@gc.BlobsDeleted</strong></div>
                    <div class="kv"><span>uploads reaped</span><strong>@gc.UploadsReaped</strong></div>
                </div>
            }
        </div>

        <div class="panel stack">
            <h3>Lifecycle Sweep</h3>

            <div class="field">
                <label>Now Override</label>
                <input class="input mono" @bind="sweepNow" placeholder="@DateTimeOffset.UtcNow.ToString("u")" />
            </div>

            <button type="button" class="btn btn-primary" @onclick="RunSweep" disabled="@sweepBusy">
                <Icon Name="refresh" /> @(sweepBusy ? "running..." : "run")
            </button>

            @if (sweepReport is { } sweep)
            {
                <hr />
                <div class="stack gap-2">
                    <div class="kv"><span>versions expired</span><strong>@sweep.Expired</strong></div>
                    <div class="kv"><span>markers reaped</span><strong>@sweep.MarkersReaped</strong></div>
                </div>
            }
        </div>

        <div class="panel stack">
            <h3>Compaction</h3>

            <div class="field">
                <label>Min Log Bytes</label>
                <input type="number" class="input mono" @bind="compactMinBytes" />
            </div>

            <button type="button" class="btn btn-primary" @onclick="RunCompact" disabled="@compactBusy">
                <Icon Name="server" /> @(compactBusy ? "running..." : "run")
            </button>

            @if (compactReport is { } compact)
            {
                <hr />
                <div class="stack gap-2">
                    <div class="kv"><span>buckets compacted</span><strong>@compact.BucketsCompacted</strong></div>
                    <div class="kv"><span>failed</span><strong>@compact.Failed</strong></div>
                    <div class="kv"><span>log size</span><strong>@Fmt.Bytes(compact.LogBytesBefore) → @Fmt.Bytes(compact.LogBytesAfter)</strong></div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private long gcBlobAgeSec = 3600;
    private long gcUploadAgeSec = 604800;
    private string sweepNow = "";
    private bool gcBusy;
    private bool sweepBusy;
    private GcReportDto? gcReport;
    private SweepReportDto? sweepReport;
    private long compactMinBytes;
    private bool compactBusy;
    private CompactReportDto? compactReport;

    private async Task RunGc()
    {
        gcBusy = true;
        try
        {
            var res = await Client.RunGc(gcBlobAgeSec, gcUploadAgeSec);
            if (!res.TryGetValue(out var report, out var err))
            {
                Toast.Error($"GC failed: {err.Message}");
                return;
            }

            gcReport = report;
            Toast.Success($"GC complete: {report.BlobsDeleted} blobs deleted, {report.UploadsReaped} uploads reaped");
        }
        catch (Exception ex)
        {
            Toast.Error($"GC error: {ex.Message}");
        }
        finally
        {
            gcBusy = false;
        }
    }

    private async Task RunSweep()
    {
        sweepBusy = true;
        try
        {
            var res = await Client.RunSweep(string.IsNullOrWhiteSpace(sweepNow) ? null : sweepNow);
            if (!res.TryGetValue(out var report, out var err))
            {
                Toast.Error($"Sweep failed: {err.Message}");
                return;
            }

            sweepReport = report;
            Toast.Success($"Sweep complete: {report.Expired} expired, {report.MarkersReaped} markers reaped");
        }
        catch (Exception ex)
        {
            Toast.Error($"Sweep error: {ex.Message}");
        }
        finally
        {
            sweepBusy = false;
        }
    }

    private async Task RunCompact()
    {
        compactBusy = true;
        try
        {
            var res = await Client.RunCompact(compactMinBytes);
            if (!res.TryGetValue(out var report, out var err))
            {
                Toast.Error($"Compaction failed: {err.Message}");
                return;
            }
            compactReport = report;
            Toast.Success("Compaction complete");
        }
        catch (Exception ex)
        {
            Toast.Error($"Compaction error: {ex.Message}");
        }
        finally
        {
            compactBusy = false;
        }
    }
}
