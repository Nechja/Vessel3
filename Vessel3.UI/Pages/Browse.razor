@page "/buckets/{Bucket}"
@inject IVesselClient Client
@inject NavigationManager Nav

<div class="split @(openKey is null ? "" : "split--open")">
    <div class="stack">
        <div class="toolbar">
            <div class="toolbar-left">
                <BucketPath Bucket="@Bucket" Prefix="@CurrentPrefix" />
            </div>
            <div class="toolbar-search">
                <input class="input" type="search" placeholder="Filter objects..." @bind="searchFilter" @bind:event="oninput" />
            </div>
            <div class="toolbar-actions">
                <button type="button" class="btn btn-ghost" @onclick="Refresh" disabled="@loading">
                    <Icon Name="refresh" /> refresh
                </button>
                <button type="button" class="btn btn-ghost" @onclick="@(() => showConnect = true)">
                    <Icon Name="link" /> connect
                </button>
                <button type="button" class="btn btn-ghost" @onclick="@(() => showSettings = true)">
                    <Icon Name="gear" /> settings
                </button>
                <label for="browseUpload" class="btn btn-primary">
                    <Icon Name="upload" /> upload
                </label>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="callout callout-danger">
                <div>@errorMessage</div>
            </div>
        }

        <UploadDrop Bucket="@Bucket" Prefix="@CurrentPrefix" InputId="browseUpload" OnUploaded="Refresh">
        <div class="table-card">
            @if (loading && rows.Count == 0)
            {
                <div class="empty-state">loading objects...</div>
            }
            else if (!filteredRows.Any())
            {
                @if (string.IsNullOrEmpty(searchFilter))
                {
                    <EmptyState Icon="folder" Text="empty folder">
                        <label for="browseUpload" class="btn btn-primary">
                            <Icon Name="upload" /> upload
                        </label>
                    </EmptyState>
                }
                else
                {
                    <EmptyState Icon="search" Text="no matches" />
                }
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>name</th>
                            <th>size</th>
                            <th>modified</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in filteredRows)
                        {
                            <tr class="is-clickable @(openKey == row.Key ? "is-selected" : "")" @onclick="@(() => Open(row))">
                                <td>
                                    <span class="cell-link">
                                        <Icon Name="@(row.IsFolder ? "folder" : "file")" Class="faint" />
                                        <span class="mono">@row.Name@(row.IsFolder ? "/" : "")</span>
                                    </span>
                                </td>
                                <td>
                                    <span class="mono muted">@(row.IsFolder ? "—" : Fmt.Bytes(row.Size))</span>
                                </td>
                                <td>
                                    <span class="mono muted">@(row.Modified?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        </UploadDrop>

        @if (!string.IsNullOrEmpty(nextMarker))
        {
            <div class="row justify-center">
                <button type="button" class="btn btn-ghost" @onclick="LoadMore" disabled="@loading">
                    load more
                </button>
            </div>
        }
    </div>

    @if (openKey is { } key)
    {
        <ObjectInspector Bucket="@Bucket" ObjectKey="@key" OnClose="Close" OnDeleted="Deleted" />
    }
</div>

<BucketSettings Bucket="@Bucket" IsOpen="showSettings" OnClose="@(() => showSettings = false)" />
<BucketConnect Bucket="@Bucket" IsOpen="showConnect" OnClose="@(() => showConnect = false)" />

@code {
    [Parameter] public string Bucket { get; set; } = "";
    [SupplyParameterFromQuery(Name = "prefix")] public string? Prefix { get; set; }

    private string CurrentPrefix => Prefix ?? "";

    private sealed record Row(string Key, string Name, bool IsFolder, long Size, DateTimeOffset? Modified);

    private List<Row> rows = [];
    private bool loading = true;
    private string? errorMessage;
    private string? nextMarker;
    private string? openKey;
    private bool showSettings;
    private bool showConnect;
    private (string Bucket, string Prefix)? loadedState;
    private string searchFilter = "";

    private IEnumerable<Row> filteredRows
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchFilter)) return rows;
            return rows.Where(r => r.Name.Contains(searchFilter, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedState == (Bucket, CurrentPrefix)) return;
        loadedState = (Bucket, CurrentPrefix);
        openKey = null;
        nextMarker = null;
        rows.Clear();
        await Fetch(reset: true);
    }

    private Task Refresh()
    {
        nextMarker = null;
        return Fetch(reset: true);
    }

    private Task LoadMore() => Fetch(reset: false);

    private async Task Fetch(bool reset)
    {
        loading = true;
        errorMessage = null;
        try
        {
            var res = await Client.ListObjects(Bucket, CurrentPrefix, delimiter: "/", marker: nextMarker, limit: 100);
            if (!res.TryGetValue(out var page, out var err))
            {
                errorMessage = err.Message;
                return;
            }

            var batch = new List<Row>(page.Prefixes.Count + page.Objects.Count);
            foreach (var prefix in page.Prefixes)
            {
                batch.Add(new Row(prefix, LastSegment(prefix.TrimEnd('/')), true, 0, null));
            }
            foreach (var obj in page.Objects)
            {
                batch.Add(new Row(obj.Key, LastSegment(obj.Key), false, obj.Size, obj.LastModified));
            }

            if (reset)
            {
                rows = batch;
            }
            else
            {
                rows.AddRange(batch);
            }

            nextMarker = page.IsTruncated ? page.NextMarker : null;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static string LastSegment(string path)
    {
        var slash = path.LastIndexOf('/');
        return slash < 0 ? path : path[(slash + 1)..];
    }

    private void Open(Row row)
    {
        if (row.IsFolder)
        {
            Nav.NavigateTo($"buckets/{Bucket}?prefix={Uri.EscapeDataString(row.Key)}");
            return;
        }
        openKey = openKey == row.Key ? null : row.Key;
    }

    private void Close()
    {
        openKey = null;
    }

    private async Task Deleted()
    {
        openKey = null;
        await Refresh();
    }
}
