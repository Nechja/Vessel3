@page "/buckets/{Bucket}"
@inject IVesselClient Client
@inject ObjectUrls Urls
@inject IJSRuntime JS
@inject UiNotifications Toast

<div class="stack" style="gap: var(--space-4);">
    <div class="toolbar">
        <div class="toolbar-left">
            <BucketPath Bucket="@Bucket" Prefix="@CurrentPrefix" />
        </div>
        <div class="toolbar-search">
            <input class="input" type="search" placeholder="Filter objects..." @bind="searchFilter" @bind:event="oninput" />
        </div>
        <div class="toolbar-actions">
            <button type="button" class="btn btn-ghost" @onclick="Refresh" disabled="@loading">
                <Icon Name="refresh" /> refresh
            </button>
            <a href="@($"uploads?bucket={Bucket}&prefix={CurrentPrefix}")" class="btn btn-primary">
                <Icon Name="upload" /> upload
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="callout callout-danger">
            <div>@errorMessage</div>
        </div>
    }

    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>name</th>
                    <th>size</th>
                    <th>modified</th>
                    <th style="text-align: right;">actions</th>
                </tr>
            </thead>
            <tbody>
                @if (loading && rows.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="empty-state">loading objects...</td>
                    </tr>
                }
                else if (!filteredRows.Any())
                {
                    <tr>
                        <td colspan="4" class="empty-state">
                            @(string.IsNullOrEmpty(searchFilter) ? "folder is empty. click \"upload\" to add files." : "no matching objects found.")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in filteredRows)
                    {
                        <tr>
                            <td>
                                @if (row.IsFolder)
                                {
                                    <a href="@PrefixHref(row.Key)" class="row align-center" style="text-decoration:none; color:var(--color-text); font-weight:var(--weight-semibold); gap:var(--space-2);">
                                        <Icon Name="folder" Class="faint" />
                                        <span class="mono">@row.Name/</span>
                                    </a>
                                }
                                else
                                {
                                    <div class="row align-center" style="cursor:pointer; gap:var(--space-2);" @onclick="@(() => ToggleInspect(row.Key))">
                                        <Icon Name="file" Class="faint" />
                                        <span class="mono @(openKey == row.Key ? "wm-zero" : "")">@row.Name</span>
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="mono muted">@(row.IsFolder ? "—" : Fmt.Bytes(row.Size))</span>
                            </td>
                            <td>
                                <span class="mono muted">@(row.IsFolder ? "—" : row.Modified?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</span>
                            </td>
                            <td style="text-align: right;">
                                @if (row.IsFolder)
                                {
                                    <a href="@PrefixHref(row.Key)" class="btn btn-ghost btn-sm">
                                        open <Icon Name="arrow-right" />
                                    </a>
                                }
                                else
                                {
                                    <div class="row" style="justify-content: flex-end; gap: var(--space-2);">
                                        <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => Download(row.Key))">
                                            get
                                        </button>
                                        <button type="button" class="btn btn-ghost btn-sm @(openKey == row.Key ? "btn-primary" : "")" @onclick="@(() => ToggleInspect(row.Key))">
                                            info
                                        </button>
                                        @if (armedDeleteKey == row.Key)
                                        {
                                            <button type="button" class="btn btn-danger btn-sm" @onclick="@(() => Delete(row.Key))">
                                                confirm?
                                            </button>
                                            <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => armedDeleteKey = null)">
                                                cancel
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-ghost btn-sm btn-icon" title="Delete object" @onclick="@(() => armedDeleteKey = row.Key)">
                                                <Icon Name="trash" />
                                            </button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                        @if (!row.IsFolder && openKey == row.Key)
                        {
                            <tr>
                                <td colspan="4" style="background: var(--color-surface-sunken); padding: var(--space-3) var(--space-5);">
                                    <ObjectInspector Bucket="@Bucket" ObjectKey="@row.Key" />
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrEmpty(nextMarker))
    {
        <div class="row" style="justify-content: center;">
            <button type="button" class="btn btn-ghost" @onclick="LoadMore" disabled="@loading">
                load more
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public string Bucket { get; set; } = "";
    [SupplyParameterFromQuery(Name = "prefix")] public string? Prefix { get; set; }

    private string CurrentPrefix => Prefix ?? "";

    private sealed record Row(string Key, string Name, bool IsFolder, long Size, DateTimeOffset? Modified);

    private List<Row> rows = [];
    private bool loading = true;
    private string summary = "";
    private string? errorMessage;
    private string? nextMarker;
    private string? armedDeleteKey;
    private string? openKey;
    private (string Bucket, string Prefix)? loadedState;
    private string searchFilter = "";

    private IEnumerable<Row> filteredRows => string.IsNullOrWhiteSpace(searchFilter)
        ? rows
        : rows.Where(r => r.Name.Contains(searchFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        if (loadedState == (Bucket, CurrentPrefix)) return;
        loadedState = (Bucket, CurrentPrefix);
        openKey = null;
        armedDeleteKey = null;
        nextMarker = null;
        rows.Clear();
        await Fetch(reset: true);
    }

    private Task Refresh()
    {
        nextMarker = null;
        return Fetch(reset: true);
    }

    private Task LoadMore() => Fetch(reset: false);

    private async Task Fetch(bool reset)
    {
        loading = true;
        errorMessage = null;
        try
        {
            var res = await Client.ListObjectsAsync(Bucket, CurrentPrefix, delimiter: "/", marker: nextMarker, limit: 100);
            if (!res.TryGetValue(out var page, out var err))
            {
                errorMessage = err.Message;
                loading = false;
                return;
            }

            var folderRows = page.Prefixes.Select(p =>
            {
                var trimmed = p.TrimEnd('/');
                var name = trimmed.Contains('/') ? trimmed[(trimmed.LastIndexOf('/') + 1)..] : trimmed;
                return new Row(p, name, true, 0, null);
            });

            var objectRows = page.Objects.Select(o =>
            {
                var name = o.Key.Contains('/') ? o.Key[(o.Key.LastIndexOf('/') + 1)..] : o.Key;
                return new Row(o.Key, name, false, o.Size, o.LastModified);
            });

            var batch = folderRows.Concat(objectRows).ToList();
            if (reset)
            {
                rows = batch;
            }
            else
            {
                rows.AddRange(batch);
            }

            nextMarker = page.IsTruncated ? page.NextMarker : null;
            summary = $"{rows.Count} item{(rows.Count == 1 ? "" : "s")}";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            summary = "error loading objects";
        }
        finally
        {
            loading = false;
        }
    }

    private string PrefixHref(string key) => $"buckets/{Bucket}?prefix={Uri.EscapeDataString(key)}";

    private void ToggleInspect(string key)
    {
        openKey = openKey == key ? null : key;
    }

    private void Download(string key)
    {
        try
        {
            _ = JS.InvokeVoidAsync("window.open", Urls.For(Bucket, key), "_blank");
        }
        catch (Exception ex)
        {
            Toast.Error($"Download failed: {ex.Message}");
        }
    }

    private async Task Delete(string key)
    {
        armedDeleteKey = null;
        try
        {
            var res = await Client.DeleteObjectAsync(Bucket, key);
            if (res.TryGetError(out var err))
            {
                Toast.Error($"Failed to delete {key}: {err.Message}");
                return;
            }
            Toast.Success($"Deleted {key}");
            if (openKey == key) openKey = null;
            await Refresh();
        }
        catch (Exception ex)
        {
            Toast.Error($"Delete error: {ex.Message}");
        }
    }
}
