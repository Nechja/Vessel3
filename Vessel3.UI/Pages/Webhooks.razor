@page "/webhooks"
@using System.Globalization
@inject IVesselClient Client
@inject UiNotifications Toast
@inject IJSRuntime JS

<div class="split @(selected is null ? "" : "split--open")">
    <div class="stack">
        <div class="toolbar">
            <div class="toolbar-left">
                <span class="toolbar-title">Webhooks</span>
                <span class="counter">@Filtered.Count</span>
            </div>
            <div class="toolbar-search">
                <input class="input" type="search" placeholder="Filter webhooks..." @bind="searchFilter" @bind:event="oninput" />
            </div>
            <div class="toolbar-actions">
                <button type="button" class="btn btn-ghost" @onclick="Refresh" disabled="@loading">
                    <Icon Name="refresh" /> refresh
                </button>
                <button type="button" class="btn btn-ghost" @onclick="OpenExport">
                    <Icon Name="file" /> export yaml
                </button>
                <button type="button" class="btn btn-primary" @onclick="OpenNew">
                    <Icon Name="bolt" /> new webhook
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="callout callout-danger">
                <div>@errorMessage</div>
            </div>
        }

        <div class="table-card">
            @if (loading)
            {
                <div class="empty-state">loading webhooks...</div>
            }
            else if (Filtered.Count == 0)
            {
                @if (string.IsNullOrWhiteSpace(searchFilter))
                {
                    <EmptyState Icon="bolt" Text="no webhooks">
                        <button type="button" class="btn btn-primary" @onclick="OpenNew">
                            <Icon Name="bolt" /> new webhook
                        </button>
                    </EmptyState>
                }
                else
                {
                    <EmptyState Icon="search" Text="no matches" />
                }
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>name</th>
                            <th>events</th>
                            <th>status</th>
                            <th>last delivery</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hook in Filtered)
                        {
                            <tr class="is-clickable @(selected?.Id == hook.Id ? "is-selected" : "")" @onclick="@(() => Select(hook))">
                                <td>
                                    <div class="stack gap-1">
                                        <span class="cell-link">
                                            <Icon Name="bolt" Class="faint" />
                                            <span>@hook.Name</span>
                                            @if (hook.IsStatic)
                                            {
                                                <span class="badge badge-neutral badge-sm">yaml</span>
                                            }
                                        </span>
                                        <span class="meta cell-ellipsis" title="@hook.Url">@hook.Url</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="row wrap-items gap-1">
                                        @foreach (var filter in hook.EventFilters)
                                        {
                                            <span class="badge badge-neutral badge-sm">@filter</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(hook.Active ? "badge-mint" : "badge-neutral") badge-sm">@(hook.Active ? "active" : "off")</span>
                                </td>
                                <td>
                                    @if (hook.LastTriggeredAt is { } last)
                                    {
                                        <div class="row align-center gap-2">
                                            <span class="badge @(hook.LastStatusCode is >= 200 and < 300 ? "badge-mint" : "badge-danger") badge-sm">@(hook.LastStatusCode?.ToString() ?? "err")</span>
                                            <span class="meta">@last.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="meta">never</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @if (selected is { } open)
    {
        <WebhookInspector Hook="open" OnClose="@(() => selected = null)" OnEdit="@(() => OpenEdit(open))" OnDelete="@(() => pendingDelete = open)" OnPinged="Refresh" />
    }
</div>

<Modal IsOpen="showForm" Title="@(editing is null ? "New webhook" : editing.Name)" OnClose="CloseForm">
    <ChildContent>
        <div class="stack">
            <div class="field">
                <label>Name</label>
                <input class="input mono" @bind="formName" />
            </div>
            <div class="field">
                <label>URL</label>
                <input class="input mono" @bind="formUrl" placeholder="https://" />
            </div>
            <div class="field">
                <label>Secret</label>
                <input class="input mono" type="password" @bind="formSecret" placeholder="@(editing is null ? "optional" : "unchanged")" />
            </div>
            <div class="field">
                <label>Events</label>
                <input class="input mono" @bind="formEvents" placeholder="comma separated" />
                <div class="row wrap-items gap-1">
                    @foreach (var topic in EventPresets)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => formEvents = topic)">@topic</button>
                    }
                </div>
            </div>
            <div class="field">
                <label>Resources</label>
                <input class="input mono" @bind="formResources" placeholder="comma separated, empty for all" />
            </div>
            <label class="check"><input type="checkbox" @bind="formActive" /> active</label>
        </div>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-ghost" @onclick="CloseForm">cancel</button>
        <button type="button" class="btn btn-primary" @onclick="Save" disabled="@saving">
            @(saving ? "saving..." : "save")
        </button>
    </FooterContent>
</Modal>

<Modal IsOpen="showExport" Title="webhooks.yaml" OnClose="@(() => showExport = false)">
    <ChildContent>
        <pre class="code-block">@exportedYaml</pre>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-ghost" @onclick="@(() => showExport = false)">close</button>
        <button type="button" class="btn btn-primary" @onclick="CopyYaml">
            <Icon Name="copy" /> copy
        </button>
    </FooterContent>
</Modal>

<ConfirmDialog Title="Delete webhook" Target="@pendingDelete?.Name" OnConfirm="Delete" OnCancel="@(() => pendingDelete = null)" />

@code {
    private static readonly string[] EventPresets = ["object.*", "object.created", "bucket.*", "container.*", "container.image.pushed", "*"];

    private List<WebhookDto> webhooks = [];
    private WebhookDto? selected;
    private WebhookDto? pendingDelete;
    private bool loading = true;
    private string errorMessage = "";
    private string searchFilter = "";

    private bool showForm;
    private bool saving;
    private WebhookDto? editing;
    private string formName = "";
    private string formUrl = "";
    private string formSecret = "";
    private string formEvents = "";
    private string formResources = "";
    private bool formActive = true;

    private bool showExport;
    private string exportedYaml = "";

    private List<WebhookDto> Filtered
    {
        get
        {
            var term = searchFilter.Trim();
            if (term.Length == 0) return webhooks;
            return webhooks.Where(w => Matches(w, term)).ToList();
        }
    }

    private static bool Matches(WebhookDto hook, string term)
    {
        if (hook.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) return true;
        if (hook.Url.Contains(term, StringComparison.OrdinalIgnoreCase)) return true;
        if (hook.EventFilters.Any(e => e.Contains(term, StringComparison.OrdinalIgnoreCase))) return true;
        return hook.ResourceFilters?.Any(r => r.Contains(term, StringComparison.OrdinalIgnoreCase)) == true;
    }

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    private async Task Refresh()
    {
        loading = webhooks.Count == 0;
        errorMessage = "";
        try
        {
            var res = await Client.ListWebhooks();
            if (!res.TryGetValue(out var list, out var err))
            {
                errorMessage = $"Failed to load webhooks: {err.Message}";
                return;
            }
            webhooks = list.OrderBy(w => w.Name, StringComparer.Ordinal).ToList();
            if (selected is { } open)
            {
                selected = webhooks.FirstOrDefault(w => w.Id == open.Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void Select(WebhookDto hook)
    {
        selected = selected?.Id == hook.Id ? null : hook;
    }

    private void OpenNew()
    {
        editing = null;
        formName = "";
        formUrl = "";
        formSecret = "";
        formEvents = "object.*";
        formResources = "";
        formActive = true;
        showForm = true;
    }

    private void OpenEdit(WebhookDto hook)
    {
        editing = hook;
        formName = hook.Name;
        formUrl = hook.Url;
        formSecret = "";
        formEvents = string.Join(", ", hook.EventFilters);
        formResources = hook.ResourceFilters is { } resources ? string.Join(", ", resources) : "";
        formActive = hook.Active;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        editing = null;
    }

    private async Task Save()
    {
        var name = formName.Trim();
        var url = formUrl.Trim();
        var events = Split(formEvents);
        if (name.Length == 0 || url.Length == 0 || events.Count == 0)
        {
            Toast.Error("Name, URL and at least one event are required");
            return;
        }

        var resources = Split(formResources);
        var secret = string.IsNullOrWhiteSpace(formSecret) ? editing?.Secret : formSecret.Trim();

        saving = true;
        try
        {
            if (editing is { } hook)
            {
                var updated = await Client.UpdateWebhook(hook.Id, new UpdateWebhookDto(name, url, secret, events, resources.Count == 0 ? null : resources, formActive));
                if (updated.TryGetError(out var updateErr))
                {
                    Toast.Error($"Failed to update webhook: {updateErr.Message}");
                    return;
                }
            }
            else
            {
                var created = await Client.CreateWebhook(new CreateWebhookDto(name, url, secret, events, resources.Count == 0 ? null : resources, formActive));
                if (created.TryGetError(out var createErr))
                {
                    Toast.Error($"Failed to create webhook: {createErr.Message}");
                    return;
                }
            }
            Toast.Success($"Saved {name}");
            CloseForm();
            await Refresh();
        }
        catch (Exception ex)
        {
            Toast.Error($"Error: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private static List<string> Split(string text) =>
        text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private async Task Delete()
    {
        if (pendingDelete is not { } hook) return;
        pendingDelete = null;
        try
        {
            var res = await Client.DeleteWebhook(hook.Id);
            if (res.TryGetError(out var err))
            {
                Toast.Error($"Failed to delete webhook: {err.Message}");
                return;
            }
            Toast.Success($"Deleted {hook.Name}");
            selected = null;
            await Refresh();
        }
        catch (Exception ex)
        {
            Toast.Error($"Delete error: {ex.Message}");
        }
    }

    private async Task OpenExport()
    {
        try
        {
            var res = await Client.ExportWebhooksYaml();
            if (!res.TryGetValue(out var yaml, out var err))
            {
                Toast.Error($"Export failed: {err.Message}");
                return;
            }
            exportedYaml = yaml;
            showExport = true;
        }
        catch (Exception ex)
        {
            Toast.Error($"Export error: {ex.Message}");
        }
    }

    private async Task CopyYaml()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", exportedYaml);
            Toast.Success("Copied");
        }
        catch (Exception ex)
        {
            Toast.Error($"Copy failed: {ex.Message}");
        }
    }
}
