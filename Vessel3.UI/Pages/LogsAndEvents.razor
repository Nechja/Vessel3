@page "/logs"
@using System.Globalization
@implements IDisposable
@inject IVesselClient Client
@inject UiConfig Config
@inject UiNotifications Toast

<div class="split @(PanelOpen ? "split--open" : "")">
    <div class="stack">
        <div class="toolbar">
            <div class="toolbar-left">
                <span class="toolbar-title">Logs &amp; Events</span>
            </div>
            <div class="toolbar-actions">
                @if (tab == Tab.Events)
                {
                    <button type="button" class="btn @(streaming ? "btn-primary" : "btn-ghost")" @onclick="ToggleStream">
                        <Icon Name="bolt" /> live
                    </button>
                    @if (streaming)
                    {
                        <button type="button" class="btn @(paused ? "btn-primary" : "btn-ghost")" @onclick="@(() => paused = !paused)">
                            pause
                        </button>
                    }
                    <button type="button" class="btn btn-ghost" @onclick="ClearEvents" disabled="@(events.Count == 0)">
                        <Icon Name="trash" /> clear
                    </button>
                }
                else
                {
                    <button type="button" class="btn @(autoRefresh ? "btn-primary" : "btn-ghost")" @onclick="ToggleAutoRefresh">
                        <Icon Name="activity" /> live
                    </button>
                    <button type="button" class="btn btn-ghost" @onclick="RefreshLogs" disabled="@loadingLogs">
                        <Icon Name="refresh" /> refresh
                    </button>
                    <button type="button" class="btn btn-ghost" @onclick="ClearLogs" disabled="@(logs.Count == 0)">
                        <Icon Name="trash" /> clear
                    </button>
                }
            </div>
        </div>

        <div class="tabs">
            <button type="button" class="tab @(tab == Tab.Events ? "is-active" : "")" @onclick="@(() => SetTab(Tab.Events))">
                events <span class="counter">@events.Count</span>
            </button>
            <button type="button" class="tab @(tab == Tab.Logs ? "is-active" : "")" @onclick="@(() => SetTab(Tab.Logs))">
                logs <span class="counter">@VisibleLogs.Count</span>
            </button>
        </div>

        @if (tab == Tab.Events)
        {
            <div class="row align-center wrap-items gap-2">
                <div class="filter flex-1">
                    <span>topic</span>
                    <input class="input mono" type="text" @bind="topicFilter" @bind:event="oninput" @onkeydown="OnFilterKey" />
                </div>
                <div class="filter flex-1">
                    <span>resource</span>
                    <input class="input mono" type="text" @bind="resourceFilter" @bind:event="oninput" @onkeydown="OnFilterKey" />
                </div>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ApplyFilters">apply</button>
            </div>

            <div class="table-card">
                @if (events.Count == 0)
                {
                    @if (streaming)
                    {
                        <EmptyState Icon="bolt" Text="listening for events" />
                    }
                    else
                    {
                        <EmptyState Icon="bolt" Text="disconnected">
                            <button type="button" class="btn btn-primary" @onclick="ToggleStream">
                                <Icon Name="bolt" /> live
                            </button>
                        </EmptyState>
                    }
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>time</th>
                                <th>topic</th>
                                <th>subject</th>
                                <th>actor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evt in events)
                            {
                                <tr class="is-clickable @(selectedEvent?.Id == evt.Id ? "is-selected" : "")" @onclick="@(() => SelectEvent(evt))">
                                    <td class="meta">@evt.Time.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture)</td>
                                    <td><span class="badge @TopicBadge(evt.Type) badge-sm">@evt.Type</span></td>
                                    <td><span class="mono cell-ellipsis" title="@evt.Subject">@evt.Subject</span></td>
                                    <td class="meta">@(evt.Actor ?? "anonymous")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else
        {
            <div class="row align-center wrap-items gap-3">
                <div class="filter">
                    <span>level</span>
                    <select class="select mono" @bind="levelFilter" @bind:after="RefreshLogs">
                        <option value="">all</option>
                        <option value="Information">info</option>
                        <option value="Warning">warn</option>
                        <option value="Error">error</option>
                    </select>
                </div>
                <div class="filter">
                    <span>protocol</span>
                    <select class="select mono" @bind="protocolFilter" @bind:after="RefreshLogs">
                        <option value="">all</option>
                        <option value="@VesselProtocols.S3">s3</option>
                        <option value="@VesselProtocols.Azure">azure</option>
                        <option value="@VesselProtocols.Oci">oci</option>
                        <option value="@VesselProtocols.Native">native</option>
                        <option value="@VesselProtocols.WebDav">webdav</option>
                        @if (Config.ClusterEnabled)
                        {
                            <option value="@VesselProtocols.Cluster">cluster</option>
                        }
                    </select>
                </div>
                <div class="filter">
                    <span>limit</span>
                    <select class="select mono" @bind="logLimit" @bind:after="RefreshLogs">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="250">250</option>
                        <option value="500">500</option>
                    </select>
                </div>
                <label class="check"><input type="checkbox" @bind="showConsoleRequests" /> console requests</label>
                @if (Config.ClusterEnabled)
                {
                    <label class="check"><input type="checkbox" @bind="showGossip" /> gossip</label>
                }
            </div>

            <div class="table-card">
                @if (loadingLogs && logs.Count == 0)
                {
                    <div class="empty-state">loading...</div>
                }
                else if (VisibleLogs.Count == 0)
                {
                    <EmptyState Icon="logs" Text="no log entries" />
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>time</th>
                                <th>level</th>
                                <th>protocol</th>
                                <th>action</th>
                                <th>status</th>
                                <th class="text-right">latency</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in VisibleLogs)
                            {
                                <tr class="is-clickable @(selectedLog?.Id == entry.Id ? "is-selected" : "")" @onclick="@(() => SelectLog(entry))">
                                    <td class="meta">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff", CultureInfo.InvariantCulture)</td>
                                    <td><span class="badge @LogLevel.Badge(entry.Level) badge-sm">@LogLevel.Label(entry.Level)</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(entry.Protocol))
                                        {
                                            <span class="badge badge-neutral badge-sm">@entry.Protocol</span>
                                        }
                                    </td>
                                    <td><span class="mono cell-ellipsis" title="@entry.Message">@(entry.Action ?? entry.Message)</span></td>
                                    <td>
                                        @if (entry.StatusCode is { } status)
                                        {
                                            <span class="badge @StatusBadge(status) badge-sm">@status</span>
                                        }
                                    </td>
                                    <td class="meta text-right">@(entry.DurationMs is { } ms ? $"{ms:F1}ms" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>

    @if (tab == Tab.Events && selectedEvent is { } evtOpen)
    {
        <EventInspector Event="evtOpen" OnClose="@(() => selectedEvent = null)" />
    }
    else if (tab == Tab.Logs && selectedLog is { } logOpen)
    {
        <LogInspector Entry="logOpen" OnClose="@(() => selectedLog = null)" />
    }
</div>

@code {
    private const int MaxEvents = 300;

    private enum Tab { Events, Logs }

    private Tab tab = Tab.Events;

    private readonly List<VesselEventDto> events = [];
    private CancellationTokenSource? streamCts;
    private bool streaming;
    private bool paused;
    private string topicFilter = "";
    private string resourceFilter = "";
    private VesselEventDto? selectedEvent;

    private List<ServerLogEntryDto> logs = [];
    private bool loadingLogs;
    private bool autoRefresh;
    private PeriodicTimer? timer;
    private string levelFilter = "";
    private string protocolFilter = "";
    private int logLimit = 100;
    private bool showConsoleRequests;
    private bool showGossip;
    private ServerLogEntryDto? selectedLog;

    private bool PanelOpen => tab == Tab.Events ? selectedEvent is not null : selectedLog is not null;

    private List<ServerLogEntryDto> VisibleLogs
    {
        get
        {
            var visible = new List<ServerLogEntryDto>(logs.Count);
            foreach (var entry in logs)
            {
                if (!showConsoleRequests && IsConsoleRequest(entry)) continue;
                if (!showGossip && entry.Protocol == VesselProtocols.Cluster) continue;
                visible.Add(entry);
            }
            return visible;
        }
    }

    private static bool IsConsoleRequest(ServerLogEntryDto entry) =>
        entry.Message.Contains("/_ui/", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        StartStream();
        await RefreshLogs();
    }

    private void SetTab(Tab next)
    {
        tab = next;
    }

    private void ToggleStream()
    {
        if (streaming)
        {
            StopStream();
            return;
        }
        StartStream();
    }

    private void StartStream()
    {
        streamCts?.Dispose();
        streamCts = new CancellationTokenSource();
        streaming = true;
        paused = false;
        _ = Consume(streamCts.Token);
    }

    private void StopStream()
    {
        streamCts?.Cancel();
        streaming = false;
    }

    private async Task Consume(CancellationToken token)
    {
        var topic = string.IsNullOrWhiteSpace(topicFilter) ? null : topicFilter.Trim();
        var resource = string.IsNullOrWhiteSpace(resourceFilter) ? null : resourceFilter.Trim();
        try
        {
            await foreach (var evt in Client.StreamEvents(topic, resource, token))
            {
                if (paused) continue;
                events.Insert(0, evt);
                if (events.Count > MaxEvents)
                {
                    events.RemoveAt(events.Count - 1);
                }
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Toast.Error($"Event stream disconnected: {ex.Message}");
        }
        finally
        {
            streaming = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        StopStream();
        StartStream();
    }

    private void OnFilterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplyFilters();
    }

    private void ClearEvents()
    {
        events.Clear();
        selectedEvent = null;
    }

    private void SelectEvent(VesselEventDto evt)
    {
        selectedEvent = selectedEvent?.Id == evt.Id ? null : evt;
    }

    private static string TopicBadge(string type)
    {
        if (type.EndsWith("deleted", StringComparison.OrdinalIgnoreCase)) return "badge-danger";
        if (type.EndsWith("created", StringComparison.OrdinalIgnoreCase) || type.EndsWith("pushed", StringComparison.OrdinalIgnoreCase)) return "badge-mint";
        return "badge-neutral";
    }

    private async Task RefreshLogs()
    {
        loadingLogs = true;
        try
        {
            var res = await Client.GetServerLogs(logLimit, levelFilter, protocolFilter);
            if (!res.TryGetValue(out var entries, out var err))
            {
                Toast.Error(err.Message);
                return;
            }
            logs = [.. entries];
        }
        finally
        {
            loadingLogs = false;
        }
    }

    private async Task ClearLogs()
    {
        var res = await Client.ClearServerLogs();
        if (res.TryGetError(out var err))
        {
            Toast.Error(err.Message);
            return;
        }
        logs.Clear();
        selectedLog = null;
    }

    private void ToggleAutoRefresh()
    {
        autoRefresh = !autoRefresh;
        timer?.Dispose();
        timer = null;
        if (!autoRefresh) return;

        timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = Poll(timer);
    }

    private async Task Poll(PeriodicTimer ticker)
    {
        try
        {
            while (await ticker.WaitForNextTickAsync())
            {
                if (tab != Tab.Logs) continue;
                await RefreshLogs();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void SelectLog(ServerLogEntryDto entry)
    {
        selectedLog = selectedLog?.Id == entry.Id ? null : entry;
    }

    private static string StatusBadge(int status) => status switch
    {
        >= 400 => "badge-danger",
        >= 300 => "badge-neutral",
        >= 200 => "badge-mint",
        _ => "badge-neutral"
    };

    public void Dispose()
    {
        streamCts?.Cancel();
        streamCts?.Dispose();
        timer?.Dispose();
    }
}
