@page "/container-repos"
@inject IVesselClient Client
@inject UiNotifications Toast
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="split @(openRepo is null ? "" : "split--open")">
    <div class="stack">
        <div class="toolbar">
            <div class="toolbar-left">
                <span class="toolbar-title">Container Repos</span>
                <span class="counter">@filteredRepos.Count</span>
            </div>
            <div class="toolbar-search">
                <input class="input" type="search" placeholder="Filter container repos..." @bind="searchFilter" @bind:event="oninput" />
            </div>
            <div class="toolbar-actions">
                <button type="button" class="btn btn-ghost" @onclick="Refresh" disabled="@loading">
                    <Icon Name="refresh" /> refresh
                </button>
                <a href="webhooks" class="btn btn-ghost">
                    <Icon Name="bolt" /> webhooks
                </a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="callout callout-danger">
                <div>@errorMessage</div>
            </div>
        }

        <div class="table-card">
            @if (loading)
            {
                <div class="empty-state">loading container repos...</div>
            }
            else if (filteredRepos.Count == 0)
            {
                @if (string.IsNullOrEmpty(searchFilter))
                {
                    <EmptyState Icon="server" Text="no container repos">
                        <div class="copy-field">
                            <input class="input mono text-xs" readonly value="@LoginCommand" />
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => Copy(LoginCommand))">
                                <Icon Name="copy" />
                            </button>
                        </div>
                        <div class="copy-field">
                            <input class="input mono text-xs" readonly value="@PushCommand" />
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => Copy(PushCommand))">
                                <Icon Name="copy" />
                            </button>
                        </div>
                    </EmptyState>
                }
                else
                {
                    <EmptyState Icon="search" Text="no matches" />
                }
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>repo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var repo in filteredRepos)
                        {
                            <tr class="is-clickable @(openRepo == repo ? "is-selected" : "")" @onclick="@(() => Open(repo))">
                                <td>
                                    <span class="cell-link">
                                        <Icon Name="server" Class="faint" />
                                        <span class="mono">@repo</span>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @if (openRepo is { } selected)
    {
        <RepoInspector Repo="@selected" OnClose="Close" />
    }
</div>

@code {
    private bool loading = true;
    private string errorMessage = "";
    private string searchFilter = "";
    private List<string> allRepos = [];
    private string? openRepo;

    private List<string> filteredRepos
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchFilter)) return allRepos;
            return allRepos.Where(r => r.Contains(searchFilter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private string Host => new Uri(Nav.BaseUri).Authority;

    private string LoginCommand => $"docker login {Host} -u <accessKey> -p <secretKey>";

    private string PushCommand => $"docker push {Host}/drummer:latest";

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    private async Task Refresh()
    {
        loading = true;
        errorMessage = "";
        try
        {
            var res = await Client.ListContainerRepos();
            if (!res.TryGetValue(out var repos, out var err))
            {
                errorMessage = $"Failed to load container repos: {err.Message}";
                return;
            }
            allRepos = repos.OrderBy(r => r, StringComparer.Ordinal).ToList();
            if (openRepo is not null && !allRepos.Contains(openRepo))
            {
                openRepo = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void Open(string repo)
    {
        openRepo = openRepo == repo ? null : repo;
    }

    private void Close()
    {
        openRepo = null;
    }

    private async Task Copy(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Toast.Success("Copied");
        }
        catch (Exception ex)
        {
            Toast.Error($"Copy error: {ex.Message}");
        }
    }
}
