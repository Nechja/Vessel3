@inherits LayoutComponentBase
@inject UiConfig Config
@inject UiAuth Auth
@inject Login Login
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IVesselClient Client

<div class="app-shell @(isCollapsed ? "app-shell--collapsed" : "") @(isMobileOpen ? "app-shell--mobile-open" : "")">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <a href="" class="wordmark wordmark--sidebar" @onclick="CloseMobileMenu">
                ves<span class="wm-accent">s</span>el<span class="wm-zero">3</span>
            </a>
            <button type="button" class="sidebar-collapse-btn" title="Toggle sidebar" @onclick="ToggleSidebar">
                <Icon Name="@(isCollapsed ? "chevron-right" : "chevron-left")" />
            </button>
        </div>

        <div class="sidebar-scroll">
            <div class="sidebar-section">
                <div class="sidebar-section-title">Storage</div>
                <NavLink href="" Match="NavLinkMatch.All" class="sidebar-item" @onclick="CloseMobileMenu">
                    <Icon Name="bucket" />
                    <span class="sidebar-label">Buckets</span>
                </NavLink>
                <NavLink href="container-repos" class="sidebar-item" @onclick="CloseMobileMenu">
                    <Icon Name="server" />
                    <span class="sidebar-label">Container Repos</span>
                </NavLink>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-section-title">Access</div>
                <NavLink href="iam" class="sidebar-item" @onclick="CloseMobileMenu">
                    <Icon Name="user" />
                    <span class="sidebar-label">Users &amp; Keys</span>
                </NavLink>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-section-title">System</div>
                <NavLink href="nodes" class="sidebar-item" @onclick="CloseMobileMenu">
                    <Icon Name="server" />
                    <span class="sidebar-label">Nodes</span>
                </NavLink>
                <NavLink href="webhooks" class="sidebar-item" @onclick="CloseMobileMenu">
                    <Icon Name="bolt" />
                    <span class="sidebar-label">Webhooks</span>
                </NavLink>
                <NavLink href="logs" class="sidebar-item" @onclick="CloseMobileMenu">
                    <Icon Name="activity" />
                    <span class="sidebar-label">Logs &amp; Events</span>
                </NavLink>
                <NavLink href="admin" class="sidebar-item" @onclick="CloseMobileMenu">
                    <Icon Name="gear" />
                    <span class="sidebar-label">Maintenance</span>
                </NavLink>
            </div>
        </div>

        @if (capacity is { } usage)
        {
            <div class="sidebar-footer">
                <div class="progress-track">
                    <div class="progress-fill" style="width: @(usage.Percent)%"></div>
                </div>
                <span class="meta">@Fmt.Bytes(usage.Used) of @Fmt.Bytes(usage.Total)</span>
            </div>
        }
    </aside>

    <div class="sidebar-backdrop" @onclick="CloseMobileMenu"></div>

    <div class="workspace">
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="mobile-toggle" @onclick="ToggleMobileMenu" title="Menu">
                    <Icon Name="bars" />
                </button>

                <div class="global-search">
                    <div class="global-search-bar">
                        <Icon Name="search" Class="search-bar-icon" />
                        <input id="globalSearchInput"
                               class="search-bar-input"
                               type="search"
                               placeholder="Search buckets and pages..."
                               @bind="searchQuery"
                               @bind:event="oninput"
                               @onfocus="OnSearchFocus"
                               @onblur="OnSearchBlur"
                               @onkeydown="HandleKeyDown"
                               autocomplete="off" />
                        <span class="search-bar-kbd mono">Ctrl+K</span>
                    </div>

                    @if (searchFocused && SearchResults.Count > 0)
                    {
                        <div class="search-dropdown">
                            @foreach (var group in SearchResults.GroupBy(r => r.Category))
                            {
                                <div class="search-group-header">@group.Key</div>
                                @foreach (var item in group)
                                {
                                    <div class="search-item" @onmousedown="@(() => SelectResult(item.Path))">
                                        <Icon Name="@item.IconName" Class="search-item-icon" />
                                        <div class="search-item-info">
                                            <div class="search-item-title">@item.Title</div>
                                            <div class="search-item-sub">@item.Subtitle</div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="topbar-right">
                @if (Auth.Caller is { } caller)
                {
                    <span class="nav-meta-item">
                        <Icon Name="user" />
                        <span class="mono">@caller.Username</span>
                        <span class="meta">(@caller.Role.ToString().ToLowerInvariant())</span>
                    </span>
                }
                else if (Auth.IsAnonymous)
                {
                    <span class="nav-meta-item mono muted">open dev</span>
                }

                @if (Config.ClusterEnabled && !string.IsNullOrEmpty(Config.NodeId))
                {
                    <a href="nodes" class="nav-meta-item mono muted">
                        <Icon Name="server" />
                        <span>@Config.NodeId</span>
                    </a>
                }
                @if (pendingMirrorBlobs > 0)
                {
                    <a href="nodes" class="nav-meta-item badge badge-warning badge-sm">
                        @pendingMirrorBlobs pending
                    </a>
                }

                <button type="button" class="btn btn-ghost btn-sm btn-icon" title="Toggle theme" @onclick="ToggleTheme">
                    <Icon Name="@(isDark ? "sun" : "moon")" />
                </button>

                @if (Auth.Session is { } session && Config.Oidc is not null)
                {
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => Login.SignOut(session))">
                        <Icon Name="logout" /> sign out
                    </button>
                }
                else if (Auth.SignedOut)
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => Login.Begin(prompt: true))">
                        <Icon Name="login" /> sign in
                    </button>
                }
            </div>
        </header>

        <main class="page-content">
            @if (Auth.Error is { } error)
            {
                <div class="callout callout-danger mb-5">
                    <div>@error</div>
                    <a href="javascript:void(0)" @onclick="@(() => Login.Retry())" class="callout-action">retry</a>
                </div>
            }

            @Body
        </main>
    </div>
</div>

<ToastProvider />

@code {
    private const string ThemeStorageKey = "vessel3.theme";
    private const string ThemeAttribute = "data-theme";
    private const string ThemeDark = "dark";
    private const string ThemeLight = "light";
    private const string JsLocalStorageGet = "localStorage.getItem";
    private const string JsLocalStorageSet = "localStorage.setItem";
    private const string JsSetDocumentAttribute = "document.documentElement.setAttribute";
    private const string KeyEscape = "Escape";
    private const string KeyEnter = "Enter";
    private const string CategoryNavigation = "Navigation";
    private const string CategoryBuckets = "Buckets";

    private bool isDark;
    private bool isCollapsed;
    private bool isMobileOpen;
    private string searchQuery = string.Empty;
    private bool searchFocused;
    private List<BucketDto> allBuckets = [];
    private Capacity? capacity;
    private int pendingMirrorBlobs;

    private readonly record struct Capacity(long Used, long Total)
    {
        public int Percent => Total > 0 ? (int)Math.Clamp(Used * 100 / Total, 0, 100) : 0;
    }

    private sealed record SearchResult(string Title, string Subtitle, string Path, string IconName, string Category);

    private List<SearchResult> SearchResults
    {
        get
        {
            var query = searchQuery.Trim();
            if (string.IsNullOrEmpty(query)) return [];

            var results = new List<SearchResult>();

            if ("buckets".Contains(query, StringComparison.OrdinalIgnoreCase))
            {
                results.Add(new SearchResult("Buckets", "Storage buckets overview", string.Empty, "bucket", CategoryNavigation));
            }
            if ("container repos".Contains(query, StringComparison.OrdinalIgnoreCase) || "containers".Contains(query, StringComparison.OrdinalIgnoreCase) || "images".Contains(query, StringComparison.OrdinalIgnoreCase))
            {
                results.Add(new SearchResult("Container Repos", "OCI container image repos & tags", "container-repos", "server", CategoryNavigation));
            }
            if ("iam".Contains(query, StringComparison.OrdinalIgnoreCase) || "users".Contains(query, StringComparison.OrdinalIgnoreCase) || "keys".Contains(query, StringComparison.OrdinalIgnoreCase))
            {
                results.Add(new SearchResult("Users & Keys", "Users and access keys", "iam", "user", CategoryNavigation));
            }
            if ("nodes".Contains(query, StringComparison.OrdinalIgnoreCase) || "cluster".Contains(query, StringComparison.OrdinalIgnoreCase) || "volumes".Contains(query, StringComparison.OrdinalIgnoreCase))
            {
                results.Add(new SearchResult("Nodes", "Nodes and volumes", "nodes", "server", CategoryNavigation));
            }
            if ("maintenance".Contains(query, StringComparison.OrdinalIgnoreCase) || "admin".Contains(query, StringComparison.OrdinalIgnoreCase) || "system".Contains(query, StringComparison.OrdinalIgnoreCase))
            {
                results.Add(new SearchResult("Maintenance", "Cluster configuration & maintenance", "admin", "gear", CategoryNavigation));
            }
            if ("webhooks".Contains(query, StringComparison.OrdinalIgnoreCase) || "events".Contains(query, StringComparison.OrdinalIgnoreCase) || "notifications".Contains(query, StringComparison.OrdinalIgnoreCase))
            {
                results.Add(new SearchResult("Webhooks", "Event subscriptions & HTTP notifications", "webhooks", "bolt", CategoryNavigation));
            }

            var matchingBuckets = allBuckets
                .Where(b => b.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
                .Take(8);

            foreach (var b in matchingBuckets)
            {
                results.Add(new SearchResult(b.Name, $"Bucket ({b.CreatedAt:yyyy-MM-dd})", $"buckets/{b.Name}", "bucket", CategoryBuckets));
            }

            return results;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var theme = await JS.InvokeAsync<string?>(JsLocalStorageGet, ThemeStorageKey);
            if (theme == ThemeDark)
            {
                isDark = true;
                await JS.InvokeVoidAsync(JsSetDocumentAttribute, ThemeAttribute, ThemeDark);
            }
            else if (theme == ThemeLight)
            {
                isDark = false;
                await JS.InvokeVoidAsync(JsSetDocumentAttribute, ThemeAttribute, ThemeLight);
            }
        }
        catch
        {
        }

        await LoadBuckets();
        await LoadCapacity();
    }

    private async Task LoadCapacity()
    {
        try
        {
            var res = await Client.GetClusterStatus();
            if (!res.TryGetValue(out var status, out _)) return;
            pendingMirrorBlobs = status.PendingMirrorBlobs;

            long total = 0;
            long available = 0;
            foreach (var volume in status.Volumes)
            {
                if (volume.IsRemote || volume.CapacityBytes is not > 0) continue;
                total += volume.CapacityBytes.Value;
                available += volume.AvailableBytes ?? 0;
            }
            if (total > 0)
            {
                capacity = new Capacity(Math.Max(0, total - available), total);
            }
        }
        catch
        {
        }
    }

    private async Task LoadBuckets()
    {
        try
        {
            var res = await Client.ListBuckets();
            if (res.TryGetValue(out var list, out _))
            {
                allBuckets = list.OrderBy(b => b.Name, StringComparer.Ordinal).ToList();
            }
        }
        catch
        {
        }
    }

    private void ToggleSidebar()
    {
        isCollapsed = !isCollapsed;
    }

    private void ToggleMobileMenu()
    {
        isMobileOpen = !isMobileOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileOpen = false;
    }

    private async Task OnSearchFocus()
    {
        searchFocused = true;
        if (allBuckets.Count == 0)
        {
            await LoadBuckets();
        }
    }

    private async Task OnSearchBlur()
    {
        await Task.Delay(200);
        searchFocused = false;
    }

    private void SelectResult(string path)
    {
        searchQuery = "";
        searchFocused = false;
        Nav.NavigateTo(path);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == KeyEscape)
        {
            searchQuery = string.Empty;
            searchFocused = false;
            return;
        }

        if (e.Key == KeyEnter)
        {
            var list = SearchResults;
            if (list.Count > 0)
            {
                SelectResult(list[0].Path);
            }
        }
    }

    private async Task ToggleTheme()
    {
        isDark = !isDark;
        var nextTheme = isDark ? ThemeDark : ThemeLight;
        await JS.InvokeVoidAsync(JsSetDocumentAttribute, ThemeAttribute, nextTheme);
        await JS.InvokeVoidAsync(JsLocalStorageSet, ThemeStorageKey, nextTheme);
    }
}
