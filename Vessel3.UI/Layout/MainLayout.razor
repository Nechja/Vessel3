@inherits LayoutComponentBase
@inject UiConfig Config
@inject UiAuth Auth
@inject Login Login

<MudThemeProvider Theme="Vessel3Theme.Dark" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="v3-appbar">
        <MudSpacer />
        @if (Auth.Session is { } session)
        {
            <span class="v3-mono v3-muted mr-3">@session.Subject</span>
            <MudIconButton Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" Color="Color.Inherit" OnClick="@(() => Login.SignOut(session))" />
        }
        <span class="v3-region">@Config.Region</span>
    </MudAppBar>
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0" Class="v3-drawer">
        <MudDrawerHeader Class="v3-drawer-head">
            <MudLink Href="" Color="Color.Inherit" Underline="Underline.None" Class="v3-brand">ves<span class="v3-rose">s</span>el<span class="v3-rose">3</span></MudLink>
        </MudDrawerHeader>
        <MudNavMenu Class="v3-nav">
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Storage">buckets</MudNavLink>
            <MudNavLink Href="uploads" Icon="@Icons.Material.Outlined.Upload">uploads</MudNavLink>
            <MudNavLink Href="admin" Icon="@Icons.Material.Outlined.Build">admin</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="v3-main">
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
            @if (Auth.SignedOut)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Login.Begin(prompt: true))">sign in</MudButton>
            }
            else if (Auth.Error is { } error)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">
                    @error <MudLink OnClick="@(() => Login.Retry())" Class="ml-2">sign in again</MudLink>
                </MudAlert>
                @Body
            }
            else
            {
                @Body
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>
