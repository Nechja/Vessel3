@inject IVesselClient Client
@inject ObjectUrls Urls
@inject IJSRuntime JS
@inject UiNotifications Toast

<aside class="inspector">
    <div class="inspector-head">
        <span class="inspector-title">@Name</span>
        <button type="button" class="btn btn-ghost btn-icon" @onclick="OnClose">
            <Icon Name="close" />
        </button>
    </div>

    @if (loading)
    {
        <div class="empty-state">loading...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="inspector-body">
            <div class="callout callout-danger">
                <div>@errorMessage</div>
            </div>
        </div>
    }
    else if (info is { } obj)
    {
        <div class="inspector-body">
            @if (preview is Preview.Image)
            {
                <div class="preview-image">
                    <img src="@previewUrl" alt="@Name" />
                </div>
            }
            else if (preview is Preview.Text)
            {
                <pre class="code-block code-block--wrap">@previewText</pre>
            }

            <dl class="inspector-meta">
                <dt>key</dt>
                <dd>@ObjectKey</dd>
                <dt>size</dt>
                <dd>@Fmt.Bytes(obj.Size)</dd>
                <dt>modified</dt>
                <dd>@obj.LastModified.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                <dt>etag</dt>
                <dd>@obj.ETag</dd>
            </dl>
        </div>

        <div class="inspector-actions">
            <button type="button" class="btn btn-primary btn-sm" @onclick="Download">
                <Icon Name="download" /> download
            </button>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="CopyUrl">
                <Icon Name="copy" /> copy url
            </button>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="CopyKey">
                <Icon Name="copy" /> copy key
            </button>
            @if (deleteArmed)
            {
                <button type="button" class="btn btn-danger btn-sm ml-auto" @onclick="Delete" disabled="@deleting">
                    confirm delete
                </button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="@(() => deleteArmed = false)">
                    cancel
                </button>
            }
            else
            {
                <button type="button" class="btn btn-ghost btn-sm btn-icon ml-auto" title="Delete object" @onclick="@(() => deleteArmed = true)">
                    <Icon Name="trash" />
                </button>
            }
        </div>
    }
</aside>

@code {
    const int TextPreviewChars = 16 * 1024;
    const long MaxImagePreviewBytes = 16L * 1024 * 1024;

    [Parameter, EditorRequired] public string Bucket { get; set; } = "";
    [Parameter, EditorRequired] public string ObjectKey { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    private enum Preview { None, Text, Image }

    private ObjectSummaryDto? info;
    private bool loading = true;
    private string? errorMessage;
    private Preview preview;
    private string? previewText;
    private string? previewUrl;
    private bool deleteArmed;
    private bool deleting;
    private (string Bucket, string Key)? loadedTarget;

    private string Name
    {
        get
        {
            var slash = ObjectKey.LastIndexOf('/');
            return slash < 0 ? ObjectKey : ObjectKey[(slash + 1)..];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedTarget == (Bucket, ObjectKey)) return;
        loadedTarget = (Bucket, ObjectKey);
        loading = true;
        errorMessage = null;
        info = null;
        preview = Preview.None;
        previewText = null;
        previewUrl = null;
        deleteArmed = false;

        try
        {
            var res = await Client.StatObject(Bucket, ObjectKey);
            if (!res.TryGetValue(out var stat, out var err))
            {
                errorMessage = err.Message;
                return;
            }

            info = stat;

            if (IsImage(ObjectKey) && stat.Size <= MaxImagePreviewBytes)
            {
                await LoadImagePreview();
            }
            else if (IsText(ObjectKey))
            {
                await LoadTextPreview();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadImagePreview()
    {
        var res = await Client.GetObject(Bucket, ObjectKey);
        if (!res.TryGetValue(out var download, out _)) return;

        using (download)
        {
            using var buffer = new MemoryStream();
            await download.Content.CopyToAsync(buffer);
            var mime = MimeHelper.GetMimeType(ObjectKey, download.ContentType);
            previewUrl = $"data:{mime};base64,{Convert.ToBase64String(buffer.ToArray())}";
            preview = Preview.Image;
        }
    }

    private async Task LoadTextPreview()
    {
        var res = await Client.GetObject(Bucket, ObjectKey);
        if (!res.TryGetValue(out var download, out _)) return;

        using (download)
        {
            using var reader = new StreamReader(download.Content);
            var chars = new char[TextPreviewChars];
            var read = await reader.ReadBlockAsync(chars, 0, TextPreviewChars);
            previewText = new string(chars, 0, read);
            preview = Preview.Text;
        }
    }

    private static bool IsImage(string key) =>
        HasExtension(key, ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".ico", ".avif");

    private static bool IsText(string key) =>
        HasExtension(key, ".txt", ".md", ".log", ".json", ".yaml", ".yml", ".xml", ".csv", ".toml",
            ".ini", ".sh", ".cs", ".js", ".ts", ".html", ".css", ".razor", ".csproj", ".sql", ".py", ".rs", ".go");

    private static bool HasExtension(string key, params ReadOnlySpan<string> extensions)
    {
        foreach (var extension in extensions)
        {
            if (key.EndsWith(extension, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private async Task Download()
    {
        try
        {
            await JS.InvokeVoidAsync("window.open", Urls.For(Bucket, ObjectKey), "_blank");
        }
        catch (Exception ex)
        {
            Toast.Error($"Download failed: {ex.Message}");
        }
    }

    private Task CopyUrl() => Copy(Urls.For(Bucket, ObjectKey), "URL copied");

    private Task CopyKey() => Copy(ObjectKey, "Key copied");

    private async Task Copy(string text, string message)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Toast.Success(message);
        }
        catch (Exception ex)
        {
            Toast.Error($"Copy failed: {ex.Message}");
        }
    }

    private async Task Delete()
    {
        deleting = true;
        try
        {
            var res = await Client.DeleteObject(Bucket, ObjectKey);
            if (res.TryGetError(out var err))
            {
                Toast.Error($"Failed to delete {ObjectKey}: {err.Message}");
                return;
            }
            Toast.Success($"Deleted {ObjectKey}");
            await OnDeleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"Delete error: {ex.Message}");
        }
        finally
        {
            deleting = false;
            deleteArmed = false;
        }
    }
}
