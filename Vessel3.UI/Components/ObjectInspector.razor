@inject IVesselClient Client
@inject ObjectUrls Urls
@inject IJSRuntime JS
@inject UiNotifications Toast

<div class="panel" style="margin: var(--space-3) 0;">
    @if (loading)
    {
        <div class="empty-state">loading object details...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="callout callout-danger">
            <div>@errorMessage</div>
        </div>
    }
    else if (info is { } obj)
    {
        <div class="stack" style="gap: var(--space-4);">
            <div class="grid grid-3">
                <div class="stat-card">
                    <div class="stat-kicker">size</div>
                    <div class="stat-value">@Fmt.Bytes(obj.Size)</div>
                    <div class="stat-sub">@obj.Size.ToString("N0") bytes</div>
                </div>
                <div class="stat-card">
                    <div class="stat-kicker">etag</div>
                    <div class="stat-value mono" style="font-size: var(--text-sm);">@obj.ETag</div>
                    <div class="stat-sub">content hash</div>
                </div>
                <div class="stat-card">
                    <div class="stat-kicker">modified</div>
                    <div class="stat-value mono" style="font-size: var(--text-sm);">@obj.LastModified.ToString("yyyy-MM-dd HH:mm:ss")</div>
                    <div class="stat-sub">timestamp</div>
                </div>
            </div>

            @if (previewKind == PreviewKind.Text)
            {
                <div class="field">
                    <label>Content Preview</label>
                    <pre class="panel mono" style="max-height: 280px; overflow: auto; background: var(--color-surface-sunken); font-size: var(--text-xs); white-space: pre-wrap; word-break: break-word;">@previewText</pre>
                </div>
            }
            else if (previewKind == PreviewKind.Image)
            {
                <div class="field">
                    <label>Image Preview</label>
                    <div class="panel" style="display: grid; place-items: center; background: var(--color-surface-sunken);">
                        <img src="@previewUrl" alt="@ObjectKey" style="max-width: 100%; max-height: 300px; border-radius: var(--radius-sm);" />
                    </div>
                </div>
            }

            <div class="row" style="gap: var(--space-2);">
                <button type="button" class="btn btn-primary btn-sm" @onclick="Download">
                    <Icon Name="download" /> download
                </button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="CopyUrl">
                    <Icon Name="copy" /> copy url
                </button>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="CopyKey">
                    <Icon Name="copy" /> copy key
                </button>
            </div>
        </div>
    }
</div>

@code {
    const int PreviewCap = 16 * 1024;

    [Parameter, EditorRequired] public string Bucket { get; set; } = "";
    [Parameter, EditorRequired] public string ObjectKey { get; set; } = "";

    enum PreviewKind { None, Text, Image }

    private ObjectSummaryDto? info;
    private bool loading = true;
    private string? errorMessage;
    private PreviewKind previewKind;
    private string? previewText;
    private string? previewUrl;
    private (string Bucket, string Key)? loadedTarget;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedTarget == (Bucket, ObjectKey)) return;
        loadedTarget = (Bucket, ObjectKey);
        loading = true;
        errorMessage = null;
        info = null;
        previewKind = PreviewKind.None;

        try
        {
            var res = await Client.StatObjectAsync(Bucket, ObjectKey);
            if (!res.TryGetValue(out var stat, out var err))
            {
                errorMessage = err.Message;
                loading = false;
                return;
            }

            info = stat;

            if (IsImage(ObjectKey))
            {
                previewKind = PreviewKind.Image;
                previewUrl = Urls.For(Bucket, ObjectKey);
            }
            else if (IsText(ObjectKey))
            {
                var dlRes = await Client.GetObjectAsync(Bucket, ObjectKey);
                if (dlRes.TryGetValue(out var dl, out _))
                {
                    using (dl)
                    {
                        using var reader = new StreamReader(dl.Content);
                        var buffer = new char[PreviewCap];
                        var read = await reader.ReadBlockAsync(buffer, 0, PreviewCap);
                        previewText = new string(buffer, 0, read);
                        previewKind = PreviewKind.Text;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static bool IsImage(string key) =>
        HasExtension(key, ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".ico", ".avif");

    private static bool IsText(string key) =>
        HasExtension(key, ".txt", ".md", ".log", ".json", ".yaml", ".yml", ".xml", ".csv", ".toml",
            ".ini", ".sh", ".cs", ".js", ".ts", ".html", ".css", ".razor", ".csproj", ".sql", ".py", ".rs", ".go");

    private static bool HasExtension(string key, params string[] exts) =>
        exts.Any(e => key.EndsWith(e, StringComparison.OrdinalIgnoreCase));

    private void Download()
    {
        try
        {
            _ = JS.InvokeVoidAsync("window.open", Urls.For(Bucket, ObjectKey), "_blank");
        }
        catch (Exception ex)
        {
            Toast.Error($"Download failed: {ex.Message}");
        }
    }

    private async Task CopyUrl()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Urls.For(Bucket, ObjectKey));
            Toast.Success("URL copied to clipboard");
        }
        catch (Exception ex)
        {
            Toast.Error($"Copy failed: {ex.Message}");
        }
    }

    private async Task CopyKey()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ObjectKey);
            Toast.Success("Object key copied to clipboard");
        }
        catch (Exception ex)
        {
            Toast.Error($"Copy failed: {ex.Message}");
        }
    }
}
