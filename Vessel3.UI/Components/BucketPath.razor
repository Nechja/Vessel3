<div class="breadcrumb">
    <a href="">buckets</a>
    <span class="sep">/</span>
    @if (string.IsNullOrEmpty(Prefix))
    {
        <span class="current">@Bucket</span>
    }
    else
    {
        <a href="@($"buckets/{Bucket}")">@Bucket</a>
        @foreach (var (label, prefix, isLast) in Crumbs())
        {
            <span class="sep">/</span>
            @if (isLast)
            {
                <span class="current">@label</span>
            }
            else
            {
                <a href="@($"buckets/{Bucket}?prefix={Uri.EscapeDataString(prefix)}")">@label</a>
            }
        }
    }
</div>

@code {
    [Parameter] public string Bucket { get; set; } = "";
    [Parameter] public string Prefix { get; set; } = "";

    private IEnumerable<(string Label, string Prefix, bool IsLast)> Crumbs()
    {
        var parts = Prefix.TrimEnd('/').Split('/');
        var acc = "";
        for (var i = 0; i < parts.Length; i++)
        {
            acc += parts[i] + "/";
            yield return (parts[i], acc, i == parts.Length - 1);
        }
    }
}
