<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vessel3.Server</RootNamespace>
    <AssemblyName>vessel3</AssemblyName>

    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>

    <!-- Strip features we don't use to shrink the binary -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>

    <RuntimeIdentifiers>linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <EmbedUi Condition="'$(EmbedUi)' == ''">true</EmbedUi>
    <DefineConstants Condition="'$(EmbedUi)' == 'true'">$(DefineConstants);VESSEL3_UI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vessel3.Primitives\Vessel3.Primitives.csproj" />
    <ProjectReference Include="..\Vessel3.Storage\Vessel3.Storage.csproj" />
    <ProjectReference Include="..\Vessel3.Protocols.S3\Vessel3.Protocols.S3.csproj" />
    <ProjectReference Include="..\Vessel3.Protocols.Native\Vessel3.Protocols.Native.csproj" />
    <ProjectReference Include="..\Vessel3.Protocols.Oci\Vessel3.Protocols.Oci.csproj" />
    <ProjectReference Include="..\Vessel3.Protocols.Azure\Vessel3.Protocols.Azure.csproj" />
    <ProjectReference Include="..\Vessel3.Protocols.WebDav\Vessel3.Protocols.WebDav.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="*" Condition="'$(EmbedUi)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vessel3.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateEmbeddedFilesManifest Condition="'$(EmbedUi)' == 'true'">true</GenerateEmbeddedFilesManifest>
    <UIProject>$(MSBuildThisFileDirectory)..\Vessel3.UI\Vessel3.UI.csproj</UIProject>
    <UIPublishDir>$(MSBuildThisFileDirectory)obj/ui/</UIPublishDir>
    <UIArtifactsDir>$(MSBuildThisFileDirectory)obj/ui-artifacts/</UIArtifactsDir>
  </PropertyGroup>

  <ItemGroup>
    <UISource Include="..\Vessel3.UI\**\*.cs;..\Vessel3.UI\**\*.razor;..\Vessel3.UI\**\*.csproj;..\Vessel3.UI\wwwroot\**\*;..\Vessel3.Client\**\*.cs;..\Vessel3.Client\**\*.csproj" Exclude="..\Vessel3.UI\bin\**\*;..\Vessel3.UI\obj\**\*;..\Vessel3.Client\bin\**\*;..\Vessel3.Client\obj\**\*" />
  </ItemGroup>

  <Target Name="PublishUI" Condition="'$(EmbedUi)' == 'true'" BeforeTargets="_CalculateEmbeddedFilesManifestInputs;PrepareResourceNames" Inputs="@(UISource)" Outputs="$(UIPublishDir)wwwroot/index.html">
    <Message Importance="high" Text="Publishing Vessel3.UI -> $(UIPublishDir)" />
    <Exec Command="dotnet publish &quot;$(UIProject)&quot; -c $(Configuration) --artifacts-path &quot;$(UIArtifactsDir)&quot; -o &quot;$(UIPublishDir)&quot; --nologo -v q" />
  </Target>

  <Target Name="EmbedUIAssets" Condition="'$(EmbedUi)' == 'true'" DependsOnTargets="PublishUI" BeforeTargets="_CalculateEmbeddedFilesManifestInputs;PrepareResourceNames">
    <Error Condition="!Exists('$(UIPublishDir)wwwroot/index.html')" Text="UI publish did not produce wwwroot/index.html at $(UIPublishDir)" />
    <ItemGroup>
      <_UIFile Include="$(UIPublishDir)wwwroot\**\*.*" />
      <EmbeddedResource Include="@(_UIFile)">
        <LogicalName>wwwroot/$([MSBuild]::ValueOrDefault('%(_UIFile.RecursiveDir)', '').Replace('\', '/'))%(_UIFile.Filename)%(_UIFile.Extension)</LogicalName>
        <WithCulture>false</WithCulture>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
