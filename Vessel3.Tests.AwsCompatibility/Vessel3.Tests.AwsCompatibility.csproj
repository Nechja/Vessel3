<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vessel3.Tests.AwsCompatibility</RootNamespace>
    <AssemblyName>vessel3-tests-aws</AssemblyName>

    <!-- AWSSDK is reflection-heavy; this is a JIT throwaway probe -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>

    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA5350;CS0618</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AwsSdkVersion Condition="'$(AwsSdkVersion)' == ''">3</AwsSdkVersion>
    <DefineConstants Condition="$(AwsSdkVersion.StartsWith('3'))">$(DefineConstants);AWSSDK_V3</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="$(AwsSdkVersion.StartsWith('3'))">
    <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.504.50" />
  </ItemGroup>

  <ItemGroup Condition="!$(AwsSdkVersion.StartsWith('3'))">
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.100.13" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.*" />
  </ItemGroup>

</Project>
